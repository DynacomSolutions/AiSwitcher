{
  "manifest_version": 3,
  "name": "AIS Browser",
  "version": "0.0.0",
  "description": "Lets AIS agents drive this Chrome profile through the AIS gateway.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "sidePanel",
    "alarms",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AIS Browser"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
