{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": ["chrome", "bun-types"]
  },
  "include": ["src", "test", "build.ts", "../../src/browser"]
}
