<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <action id="org.ais.host-helper">
    <description>Write the ais live image to a removable drive</description>
    <message>Authentication is required to write the ais live image to a removable drive</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ais-host/ais-host-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
