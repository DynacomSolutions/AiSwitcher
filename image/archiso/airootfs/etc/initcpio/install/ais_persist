#!/usr/bin/bash

build() {
    add_module dm-crypt
    add_module btrfs
    add_module overlay
    add_all_modules '/crypto/'
    add_module exfat
    add_binary btrfs
    add_binary cryptsetup
    add_binary mkfs.btrfs
    add_binary lsblk
    add_binary findmnt
    add_binary sfdisk
    add_binary blockdev
    add_binary blkid
    add_binary stat
    add_binary dirname
    add_binary wipefs
    add_binary grep
    add_binary chown
    add_binary awk
    add_binary tr
    add_binary cmp
    add_binary diff
    add_binary partx
    add_binary keyctl
    add_binary mount
    add_binary umount
    add_binary find
    add_binary sed
    add_binary head
    add_binary sort
    add_binary chmod
    add_binary mkdir
    add_binary cp
    add_binary rm
    add_binary stty
    add_binary sleep
    add_binary udevadm
    add_binary readlink
    add_binary date
    add_binary mv
    add_binary cat
    add_binary wc
    add_binary cut
    add_binary printf
    add_runscript
    [[ -r /etc/ais-live/agent-ids ]] || { error 'Missing required /etc/ais-live/agent-ids'; return 1; }
    printf 'uid=1001\ngid=1001\n' | cmp -s - /etc/ais-live/agent-ids || { error 'Invalid /etc/ais-live/agent-ids'; return 1; }
    add_file /etc/ais-live/agent-ids
    if [[ ! -e /etc/ais-live/base-packages ]]; then
        mkdir -p /etc/ais-live
        pacman -Qqe | LC_ALL=C sort -u >/etc/ais-live/base-packages
    fi
}

help() {
    cat <<'HELP'
Verify the boot disk and prepare encrypted AIS persistence in the late hook before the initramfs mounts its overlay; first boot creates partition 5 after confirmation.
HELP
}
