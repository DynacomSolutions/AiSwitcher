[Unit]
Description=Create and harden live image accounts
DefaultDependencies=no
After=local-fs.target
Before=getty@tty1.service serial-getty@.service

[Service]
Type=oneshot
StandardError=journal+console
ExecStart=/usr/local/lib/ais-live/ais-live-accounts
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
