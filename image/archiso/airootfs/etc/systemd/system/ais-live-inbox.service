[Unit]
Description=Authenticate and apply the highest AIS inbox bundle
Requires=ais-live-exchange.service ais-live-accounts.service
RequiresMountsFor=/mnt/persist
After=ais-live-exchange.service mnt-persist.mount ais-live-accounts.service
Before=ais-live-boot.service getty-pre.target
Wants=getty-pre.target
ConditionPathIsDirectory=/mnt/aisx/inbox
ConditionPathIsMountPoint=/mnt/persist
ConditionPathIsMountPoint=/mnt/aisx

[Service]
Type=oneshot
StandardError=journal+console
RuntimeDirectory=ais-live-exchange
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/local/lib/ais-live/ais-outbox apply-inbox
TimeoutStartSec=3min
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/mnt/aisx -/mnt/persist/ais-live-exchange /run/ais-live-exchange
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
