[Unit]
Description=Verify and expose exchange partition models
DefaultDependencies=no
Requires=ais-live-accounts.service
Wants=ais-live-exchange.service
After=local-fs.target ais-live-exchange.service ais-live-accounts.service
Before=getty@tty1.service serial-getty@.service
# The helper selects the validated persistent exchange or staged test media,
# and exits cleanly when neither source contains a model manifest.

[Service]
Type=oneshot
StandardError=journal+console
ExecStart=/usr/local/lib/ais-live/ais-live-models --mount
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
