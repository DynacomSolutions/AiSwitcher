[Unit]
Description=Prepare writable AIS live persistence before login
DefaultDependencies=no
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
Conflicts=shutdown.target
Before=getty-pre.target ais-live-outbox-shutdown.service shutdown.target
ConditionPathIsMountPoint=/mnt/persist

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ais-live/ais-live-persist
ExecStop=/usr/bin/bash -c 'keyid=$(/usr/bin/keyctl search @u user ais-live-exchange) && /usr/bin/keyctl revoke "$keyid" || true'
SuccessExitStatus=10
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
