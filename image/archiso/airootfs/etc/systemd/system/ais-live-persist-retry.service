[Unit]
Description=Retry deferred AIS live base migration
After=network-online.target ais-live-persist-ready.service
Wants=network-online.target
ConditionPathExists=/mnt/persist/@pkglist/reinstall-pending

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ais-live/ais-live-persist --retry
SuccessExitStatus=10

