[Unit]
Description=Root-only AIS exchange partition
Before=ais-live-inbox.service ais-live-outbox.service ais-live-outbox-shutdown.service

[Mount]
What=/dev/disk/by-label/AISX
Where=/mnt/aisx
Type=exfat
Options=uid=0,gid=0,umask=0077,nosuid,nodev,noexec
TimeoutSec=30

[Install]
WantedBy=local-fs.target
