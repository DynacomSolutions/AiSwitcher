#!/usr/bin/env bash
# Runtime exchange access is available only after successful persistent boot.
set -euo pipefail
mode=${1:?usage: resolve-boot-partition persist|exchange}
case "$mode" in persist|exchange) ;; *) exit 2 ;; esac
if [[ $(cat /run/ais-persist-mode 2>/dev/null) == clean || -e /run/ais-persist-ephemeral ]]; then
    [[ $mode == exchange ]]
    exit $?
fi
identity_file=/run/ais-persist-identity
[[ -f $identity_file && ! -L $identity_file && $(stat -c '%u:%a' "$identity_file") == 0:600 ]] || exit 1
# shellcheck source=../../../../etc/initcpio/hooks/ais_persist
source /etc/initcpio/hooks/ais_persist
_persist_read_drive && _persist_resolve && _persist_mapper || exit 1
[[ $(cat "$identity_file") == "$PERSIST_IDENTITY" ]] || exit 1

if [[ $mode == persist ]]; then
    cryptsetup isLuks "$PERSIST_PART" &&
        cryptsetup luksDump "$PERSIST_PART" && _persist_resolve
    exit $?
fi

_exchange_resolve() {
    local entry dev uuid count=0 identity
    _persist_mapper || return 1
    for entry in "$PERSIST_DISK_SYSFS"/*; do
        [[ -f $entry/partition && $(cat "$entry/partition") == 4 ]] || continue
        count=$((count + 1))
        dev=$(cat "$entry/dev") || return 1
        uuid=$(blkid -p -c /dev/null -s PART_ENTRY_UUID -o value "/dev/block/$dev") || return 1
        _persist_uuid_valid "$uuid" || return 1
        EXCHANGE_PART=/dev/disk/by-partuuid/$uuid
        EXCHANGE_DEV=$dev
        # Count duplicates too; a symlink is not evidence of uniqueness.
        (PERSIST_DRIVE=$uuid; PERSIST_PART=$EXCHANGE_PART; _persist_unique_target) || return 1
    done
    [[ $count == 1 ]] || return 1
    identity=$EXCHANGE_PART:$EXCHANGE_DEV
    [[ -z ${EXCHANGE_IDENTITY:-} || $identity == "$EXCHANGE_IDENTITY" ]] || return 1
    EXCHANGE_IDENTITY=$identity
}

_exchange_resolve || exit 1
if mountpoint -q /mnt/aisx; then
    [[ $(findmnt -n -o MAJ:MIN /mnt/aisx) == "$EXCHANGE_DEV" ]] && _exchange_resolve
    exit $?
fi
mkdir -p /mnt/aisx
_exchange_resolve || exit 1
mount -t exfat -o rw,uid=0,gid=0,dmask=0077,fmask=0177,nosuid,nodev,noexec "$EXCHANGE_PART" /mnt/aisx
if ! _exchange_resolve || [[ $(findmnt -n -o MAJ:MIN /mnt/aisx) != "$EXCHANGE_DEV" ]]; then
    umount /mnt/aisx
    exit 1
fi
