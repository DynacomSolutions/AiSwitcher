#!/usr/bin/bash
set -eu

mode=${1:-}
case "$mode" in persist|exchange) ;; *) exit 2 ;; esac

PERSIST_CONSOLE=/dev/null
export PERSIST_CONSOLE
# shellcheck disable=SC1091
. /etc/initcpio/hooks/ais_persist

_persist_die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}
_persist_die_ambiguous() {
    printf '%s\n' 'Unplug the other AIS live drive before using persistence or exchange storage.' >&2
    printf 'AIS-LIVE: stage=persist status=refused reason=ambiguous-boot-disk mode=%s\n' "$(cat /run/ais-persist-mode 2>/dev/null || printf latest)" >&2
    exit 1
}

identity_file=/run/ais-persist-identity
[ -r "$identity_file" ] || _persist_die 'Verified boot disk identity record is missing.'
[ "$(wc -l < "$identity_file")" -eq 8 ] || _persist_die 'Verified boot disk identity record is malformed.'
awk -F '\t' '
  NR==1 && NF==2 && $1=="AIS-PERSIST-IDENTITY" && $2=="1" {next}
  NR==2 && NF==2 && $1=="diskseq" && $2~/^[1-9][0-9]*$/ {next}
  NR==3 && NF==2 && $1=="dev" && $2~/^[0-9]+:[0-9]+$/ {next}
  NR==4 && NF==2 && $1=="sysfs" && $2~/^\/sys\/devices\/[A-Za-z0-9_./:-]+$/ {next}
  NR==5 && NF==2 && $1=="guids" && split($2,g,",")==5 {for(i=1;i<=5;i++)if(length(g[i])!=36 || g[i] !~ /^[0-9a-f-]+$/)exit 1; next}
  NR==6 && NF==2 && $1=="part4-uuid" && length($2)==36 && $2~/^[0-9a-f-]+$/ {next}
  NR==7 && NF==2 && $1=="part4-start" && $2~/^[1-9][0-9]*$/ {next}
  NR==8 && NF==2 && $1=="part4-size" && $2~/^[1-9][0-9]*$/ {next}
  {exit 1}
  END {if(NR!=8)exit 1}' "$identity_file" || _persist_die 'Verified boot disk identity record is malformed.'
identity_diskseq=$(awk -F '\t' 'NR==2 {print $2}' "$identity_file")
identity_dev=$(awk -F '\t' 'NR==3 {print $2}' "$identity_file")
identity_sysfs=$(awk -F '\t' 'NR==4 {print $2}' "$identity_file")
identity_guids=$(awk -F '\t' 'NR==5 {print $2}' "$identity_file")
identity_p4_uuid=$(awk -F '\t' 'NR==6 {print $2}' "$identity_file")
identity_p4_start=$(awk -F '\t' 'NR==7 {print $2}' "$identity_file")
identity_p4_size=$(awk -F '\t' 'NR==8 {print $2}' "$identity_file")
IFS=',' read -r -a identity_guid_rows <<<"$identity_guids"
[ "${#identity_guid_rows[@]}" -eq 5 ] || _persist_die 'Verified boot disk GUID record is malformed.'
for identity_guid in "${identity_guid_rows[@]}" "$identity_p4_uuid"; do
    _persist_uuid_valid "$identity_guid" || _persist_die 'Verified boot disk GUID record is malformed.'
    [ "$identity_guid" = "${identity_guid,,}" ] || _persist_die 'Verified boot disk GUID record is not canonical.'
done
PERSIST_DISKSEQ=$identity_diskseq
PERSIST_DISK_DEV=$identity_dev

_persist_find_device || _persist_die_ambiguous
{ [ "$PERSIST_DISKSEQ" = "$identity_diskseq" ] && [ "$PERSIST_DISK_DEV" = "$identity_dev" ] && [ "$PERSIST_DISK_SYSFS" = "$identity_sysfs" ]; } || _persist_die 'Boot disk changed since initramfs identity verification.'
_persist_verify_gpt || _persist_die 'Boot disk GPT does not match the trusted image manifest.'
_persist_verify_gpt || _persist_die 'Boot disk identity changed during verification.'
[ "$PERSIST_GUID_SNAPSHOT" = "$(printf '%s\n' "$identity_guids" | tr ',' '\n')" ] || _persist_die 'Boot disk GPT identifiers changed since initramfs verification.'
row=$(printf '%s\n' "$PERSIST_GPT_DUMP" | awk -F '\t' '$1=="part" && $2==4 {print}')
[ "$(printf '%s\n' "$row" | awk -F '\t' '{print $6}')" = "$identity_p4_uuid" ] &&
    [ "$(printf '%s\n' "$row" | awk -F '\t' '{print $3}')" = "$identity_p4_start" ] &&
    [ "$(printf '%s\n' "$row" | awk -F '\t' '{print $4}')" = "$identity_p4_size" ] || _persist_die 'Exchange partition changed since initramfs verification.'

if [ "$mode" = persist ]; then
    [ "$PERSIST_P5_PRESENT" -eq 1 ] || exit 1
    _persist_refresh_part_node 5 || exit 1
    printf '%s\n' "$PERSIST_RESOLVED_PART"
    exit 0
fi

_persist_refresh_part_node 4 || _persist_die 'Could not freshly resolve the exchange partition.'
if mountpoint -q /mnt/aisx; then
    mounted_source=$(findmnt -n -o SOURCE /mnt/aisx) || _persist_die 'Could not identify the mounted exchange partition.'
    [ "$(readlink -f "$mounted_source")" = "$(readlink -f "$PERSIST_RESOLVED_PART")" ] || _persist_die 'Mounted exchange partition does not match the verified boot disk.'
    exit 0
fi
mkdir -p /mnt/aisx
mount -t exfat -o rw,uid=0,gid=0,dmask=0077,fmask=0177,nosuid,nodev,noexec "$PERSIST_RESOLVED_PART" /mnt/aisx || exit 1
if ! _persist_check_diskseq || ! _persist_verify_gpt || ! _persist_refresh_part_node 4; then
    umount /mnt/aisx 2>/dev/null || true
    _persist_die 'Exchange partition identity changed during mount.'
fi
