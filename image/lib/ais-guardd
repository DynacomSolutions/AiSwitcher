#!/usr/bin/python3
import array, hashlib, json, os, pwd, re, secrets, select, socket, stat, struct, subprocess, sys, threading, time
from ais_guard_policy import COMMANDS, readonly, resolve_devices, unsafe_options, pacman_args, timeout_for, escape_display
SOCK='/run/ais-guard.sock'; R='/run/ais-guard/requests'; P='/run/ais-guard/packages'; MAX=65536
RATE={}; RATE_LOCK=threading.Lock(); POPUP_LOCK=threading.Lock(); PKG_LOCK=threading.Lock(); SLOTS=threading.BoundedSemaphore(16); PKG_MAX=268435456
def uid_for(name): return pwd.getpwnam(name).pw_uid
def gid_for(name): return pwd.getpwnam(name).pw_gid
def recv_req(c):
    # The first recvmsg carries descriptors and the initial JSON bytes together.
    data=bytearray(); fds=[]
    try:
        while b'\n' not in data and len(data)<=MAX:
            chunk,anc,flags,_=c.recvmsg(4096,socket.CMSG_SPACE(8*array.array('i').itemsize),getattr(socket,'MSG_CMSG_CLOEXEC',0))
            for lev,typ,b in anc:
                if lev==socket.SOL_SOCKET and typ==socket.SCM_RIGHTS:
                    a=array.array('i'); a.frombytes(b[:len(b)-len(b)%a.itemsize]); fds.extend(a.tolist())
            if flags & getattr(socket,'MSG_CTRUNC',0): raise ValueError('truncated descriptors')
            if not chunk: break
            data.extend(chunk)
            if b'\n' in data:
                if data.index(b'\n') != len(data)-1: raise ValueError('extra request bytes')
                break
        if len(data)>MAX or b'\n' not in data or len(fds)!=3: raise ValueError('malformed transport')
        req=json.loads(bytes(data).split(b'\n',1)[0]); return req,fds
    except Exception:
        for fd in fds:
            try: os.close(fd)
            except OSError: pass
        raise

def send(c,ok,reason,code=None):
    d={'approved':ok,'reason':reason}
    if code is not None:d['exit_code']=int(code)
    c.sendall((json.dumps(d,separators=(',',':'))+'\n').encode())

def rate_check(uid):
    with RATE_LOCK:
        now=time.monotonic(); stamps=[t for t in RATE.get(uid,[]) if now-t<60]
        if len(stamps)>=6: raise ValueError('rate limited')
        RATE[uid]=stamps+[now]

def device_info(path):
    p=subprocess.run(['/usr/bin/lsblk','--json','--bytes','--output','PATH,MODEL,SIZE,MOUNTPOINTS',path],capture_output=True,text=True,timeout=3,env={'PATH':'/usr/bin:/bin','LANG':'C'})
    if p.returncode: return {'path':path,'model':'unknown','size':0,'mounts':[]}
    try:
        d=json.loads(p.stdout)['blockdevices'][0]
        mounts=[]; pending=[d]
        while pending:
            node=pending.pop()
            for mount in node.get('mountpoints') or []:
                if mount and mount not in mounts: mounts.append(mount)
            pending.extend(reversed(node.get('children') or []))
        return {'path':d.get('path',path),'model':d.get('model') or 'unknown','size':d.get('size') or 0,'mounts':mounts}
    except Exception: return {'path':path,'model':'unknown','size':0,'mounts':[]}

def herdr_socket(uid):
    runtime='/run/user/'+str(uid)
    rt=os.stat(runtime)
    if rt.st_uid!=uid or stat.S_IMODE(rt.st_mode)!=0o700: raise ValueError('live runtime directory is unsafe')
    found=[]
    # The live session owns this runtime tree. Only the pinned socket basename is
    # considered, and ambiguous or unsafe discoveries fail closed.
    for base,dirs,files in os.walk(runtime,followlinks=False):
        dirs[:]=[d for d in dirs if not os.path.islink(os.path.join(base,d))]
        if 'herdr.sock' in files:
            path=os.path.join(base,'herdr.sock')
            try:
                real=os.path.realpath(path); st=os.lstat(path)
                if os.path.commonpath((runtime,real))!=runtime or not stat.S_ISSOCK(st.st_mode) or st.st_uid!=uid or stat.S_IMODE(st.st_mode)!=0o600:
                    continue
                found.append(real)
            except OSError: pass
    if len(found)!=1: raise ValueError('live herdr socket unavailable or ambiguous')
    return found[0]

def with_code(expected):
    # A per-request code means input typed ahead of the prompt can never match.
    return (expected+' '+secrets.token_hex(2)).strip()

def popup(command,devs,expected,timeout):
    # One approval pane at a time; other requests queue here (at most SLOTS threads).
    with POPUP_LOCK: return _popup(command,devs,expected,timeout)

def _popup(command,devs,expected,timeout):
    expected=with_code(expected)
    os.makedirs(R,mode=0o750,exist_ok=True); os.chown(R,0,gid_for('live')); os.chmod(R,0o750)
    rid=secrets.token_hex(16); nonce=secrets.token_urlsafe(24); path=R+'/'+rid+'.sock'; request=R+'/'+rid+'.json'
    deadline=time.monotonic()+timeout
    doc={'id':rid,'nonce':nonce,'command':command,'devices':[device_info(x[1]) for x in devs],'reply':path,'expected':expected,'deadline':deadline}
    s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
    try:
        s.bind(path); os.chmod(path,0o600); os.chown(path,uid_for('live'),gid_for('live')); s.listen(1)
    except Exception:
        s.close()
        try:os.unlink(path)
        except OSError:pass
        raise
    try:
        fd=os.open(request,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o640)
        try:
            os.fchown(fd,0,pwd.getpwnam('live').pw_gid); data=json.dumps(doc).encode(); view=memoryview(data)
            while view:
                written=os.write(fd,view); view=view[written:]
        finally:os.close(fd)
        live_uid=uid_for('live')
        home=pwd.getpwnam('live').pw_dir
        # PID 1 starts the popup as live: runuser's setuid is refused inside this unit.
        # The nonce is visible in the transient unit's properties; replies are still bound to live by SO_PEERCRED.
        opened=subprocess.run(['/usr/bin/systemd-run','--uid=live','--gid=live','--wait','--pipe','--collect','--quiet','-p','RuntimeMaxSec=15',
            '--setenv=PATH=/usr/bin:/bin','--setenv=HOME='+home,'--setenv=XDG_RUNTIME_DIR=/run/user/'+str(live_uid),'--setenv=HERDR_SOCKET_PATH='+herdr_socket(live_uid),
            '--','/usr/local/bin/herdr','plugin','pane','open','--plugin','ais-guard','--entrypoint','confirm','--placement','overlay','--env','AIS_GUARD_NONCE='+nonce,'--env','AIS_GUARD_REQ='+rid],
            env={'PATH':'/usr/bin:/bin'},stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,timeout=min(15,max(1,deadline-time.monotonic())),check=False)
        if opened.returncode!=0:
            # Log herdr's own reason (never the argv, which carries the nonce) so a failed popup is diagnosable.
            sys.stderr.write('ais-guardd: herdr popup open failed (exit %d): %s\n'%(opened.returncode,opened.stderr.decode('utf-8','replace')[:400].replace('\n',' ')))
            raise subprocess.CalledProcessError(opened.returncode,'herdr plugin pane open')
        s.settimeout(max(0.1,deadline-time.monotonic()))
        c,_=s.accept()
        try:
            c.settimeout(max(0.1,deadline-time.monotonic()))
            return validate_reply(c,nonce,expected)
        finally:c.close()
    finally:
        s.close()
        for f in (path,request):
            try:os.unlink(f)
            except OSError:pass

def validate_reply(c,nonce,expected):
    if struct.unpack('3i',c.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))[1]!=uid_for('live'):return False
    data=bytearray()
    while len(data)<=8192 and b'\n' not in data:
        part=c.recv(min(1024,8193-len(data)))
        if not part:return False
        data.extend(part)
    if len(data)>8192 or data[-1:]!=b'\n' or data.count(b'\n')!=1:return False
    answer=json.loads(data[:-1])
    return secrets.compare_digest(str(answer.get('nonce','')),nonce) and answer.get('text')==expected

def copy_pkg(src,uid,rid,cwd):
    # Source is opened by the unprivileged requester identity with O_NOFOLLOW.
    helper="import os,stat,sys; p=sys.argv[1]; fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK); s=os.fstat(fd); (s.st_size<=268435456 and stat.S_ISREG(s.st_mode)) or sys.exit(23);"
    proc=subprocess.Popen(['/usr/bin/python3','-c',helper+"\nos.write(1,b'')\nn=0\nwhile True:\n b=os.read(fd,1048576)\n if not b:break\n n+=len(b)\n if n>268435456:sys.exit(24)\n v=memoryview(b)\n while v:\n  k=os.write(1,v)\n  v=v[k:]\n" ,src],cwd=cwd,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,user=uid,group=pwd.getpwuid(uid).pw_gid,extra_groups=[],env={'PATH':'/usr/bin:/bin','HOME':pwd.getpwuid(uid).pw_dir})
    os.makedirs(P+'/'+rid,mode=0o700,exist_ok=True); dest=P+'/'+rid+'/'+secrets.token_hex(8)+'.pkg'
    out=os.open(dest,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o400); h=hashlib.sha256()
    try:
        fd=proc.stdout.fileno(); os.set_blocking(fd,False); poller=select.poll(); poller.register(fd,select.POLLIN|select.POLLHUP|select.POLLERR); deadline=time.monotonic()+90
        while True:
            if time.monotonic()>=deadline: raise TimeoutError('package copy timeout')
            ready=poller.poll(1000)
            if not ready:
                if proc.poll() is not None: break
                continue
            try:b=os.read(fd,1024*1024)
            except BlockingIOError: continue
            if not b:break
            h.update(b); view=memoryview(b)
            while view:
                n=os.write(out,view); view=view[n:]
    except Exception:
        proc.kill(); proc.wait(); os.unlink(dest)
        try:os.rmdir(os.path.dirname(dest))
        except OSError:pass
        raise
    finally:os.close(out);proc.stdout.close()
    try: result=proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill(); proc.wait(); os.unlink(dest)
        try:os.rmdir(os.path.dirname(dest))
        except OSError:pass
        raise TimeoutError('package helper did not exit')
    if result!=0:
        os.unlink(dest)
        try:os.rmdir(os.path.dirname(dest))
        except OSError:pass
        raise ValueError('invalid package file')
    os.chown(dest,0,0); return dest,h.hexdigest()

def pkg_name(dest):
    # .PKGINFO is read by an unprivileged account through an inherited descriptor, never by root.
    kw={'user':'nobody','group':'nobody','extra_groups':[]} if os.geteuid()==0 else {}
    with open(dest,'rb') as f:
        p=subprocess.Popen(['/usr/bin/bsdtar','-xOf','-','.PKGINFO'],stdin=f,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,cwd='/',env={'PATH':'/usr/bin:/bin','LANG':'C'},**kw)
        timer=threading.Timer(30,p.kill); timer.start()
        try:
            out=p.stdout.read(1048576)
            if p.stdout.read(1): raise ValueError('package metadata too large')
        finally:
            timer.cancel(); p.stdout.close()
            if p.poll() is None: p.kill()
            code=p.wait()
    names=re.findall(rb'^pkgname = (\S+)$',out,re.M)
    if code or len(names)!=1 or not re.fullmatch(rb'[A-Za-z0-9@._+-]+',names[0]): raise ValueError('package metadata invalid')
    return names[0].decode()

_DM_TOOLS=('cryptsetup','dmsetup','lvm','lvmdevices')
def sandbox_props(name,readonly_mode=False):
    """systemd properties for a root run. NoExecPaths/ExecPaths and the kernel module block apply to every tool."""
    props=['ProtectSystem=strict','ProtectHome=read-only','PrivateTmp=yes','NoNewPrivileges=yes','RestrictSUIDSGID=yes','DevicePolicy=closed','NoExecPaths=/','ExecPaths=/usr','ProtectControlGroups=yes','ProtectKernelModules=yes']
    if readonly_mode: return props+['ProtectKernelTunables=yes','RuntimeMaxSec=30']
    if name=='mdadm':
        # md assembly and creation write sysfs, so kernel tunables stay writable for this tool only.
        return props+['DeviceAllow=/dev/md* rw','DeviceAllow=block-md rw','ReadWritePaths=-/run/mdadm']
    props.append('ProtectKernelTunables=yes')
    if name in _DM_TOOLS or name.startswith(('lv','pv','vg')):
        props+=['DeviceAllow=/dev/mapper/control rw','DeviceAllow=/dev/mapper/* rw','DeviceAllow=block-device-mapper rw','ReadWritePaths=-/run/cryptsetup -/run/lock/lvm -/run/lvm -/etc/lvm']
    return props

def run_root(argv,fds,devices=(),readonly_mode=False,cwd='/'):
    cmd=['/usr/bin/systemd-run','--wait','--pipe','--collect']
    for prop in sandbox_props(os.path.basename(argv[0]),readonly_mode): cmd += ['-p',prop]
    if readonly_mode and not devices: cmd += ['-p','DeviceAllow=block-* r']
    for _,p,_ in devices:cmd += ['-p','DeviceAllow='+p+(' r' if readonly_mode else ' rw')]
    cmd += ['--working-directory='+cwd,'--',argv[0],*argv[1:]]
    return subprocess.run(cmd,stdin=fds[0],stdout=fds[1],stderr=fds[2],env={'PATH':'/usr/bin:/bin','LANG':'C','LC_ALL':'C'},close_fds=True).returncode

def handle(c):
    fds=[]
    try:
        c.settimeout(5)
        uid=struct.unpack('3i',c.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))[1]
        req,fds=recv_req(c); op=req.get('op'); a=req.get('argv'); cwd=req.get('cwd')
        if uid!=uid_for('agent') or not isinstance(a,list) or not a or len(a)>256 or any(not isinstance(x,str) or '\0' in x for x in a) or not isinstance(cwd,str):raise ValueError('invalid peer or request')
        cwd=os.path.realpath(cwd)
        if not os.path.isdir(cwd):raise ValueError('invalid cwd')
        if op=='disk':
            name=os.path.basename(a[0]); args=a[1:]
            if name not in COMMANDS:raise ValueError('command absent from guard table')
            rewritten,devs=resolve_devices(name,args,cwd)
            if devs and (cwd in ('/tmp','/var/tmp') or cwd.startswith(('/tmp/','/var/tmp/'))):
                raise ValueError('working directory under /tmp is not visible to the root sandbox; run from another directory')
            # Operand-free read-only forms may read every block device as root. Any
            # other device-free request is run by the client as agent ("local").
            if readonly(name,args):
                if devs:
                    code=run_root(['/usr/bin/'+name,*rewritten],fds,devs,True,cwd)
                elif name=='blkid' or (name=='sfdisk' and len(args)==1) or (name=='btrfs' and len(args)==2):
                    code=run_root(['/usr/bin/'+name,*rewritten],fds,(),True)
                else:
                    send(c,True,'local');return
                send(c,True,'readonly',code);return
            if any(line.split()[0]==name and line.split()[1]=='readonly-subcommands:all'
                   for line in open(os.path.join(os.path.dirname(os.path.abspath(__file__)),'ais-guard-table'),encoding='utf-8')
                   if line.strip() and not line.lstrip().startswith('#')):
                raise ValueError('read-only command grammar refused')
            # A no-device request never gains root: the client execs it as agent.
            if not devs:
                send(c,True,'local');return
            if unsafe_options(name,args):raise ValueError('unsafe command option')
            rate_check(uid)
            cmd=escape_display(json.dumps(['/usr/bin/'+name,*rewritten],ensure_ascii=True,separators=(',',':'))+' in '+json.dumps(cwd,ensure_ascii=True))
            timeout=timeout_for(open('/proc/cmdline').read())
            if not popup(cmd,devs,' '.join(os.path.basename(x[1]) for x in devs),timeout):raise ValueError('popup rejected or failed')
            for original,path,rdev in devs:
                if os.stat(path).st_rdev!=rdev:raise ValueError('device changed after approval')
            code=run_root(['/usr/bin/'+name,*rewritten],fds,devs,False,cwd);send(c,True,'root-exec',code);return
        if op in {'pacman','aur-install'}:
            args=a[1:] if a[0]=='pacman' else a
            if not args: raise ValueError('pacman arguments missing')
            if op=='pacman':
                mode,pacargv=pacman_args(args)
                if mode=='query':
                    p=subprocess.run(['/usr/bin/pacman',*pacargv],cwd='/',timeout=300,stdin=subprocess.DEVNULL,stdout=fds[1],stderr=fds[2],env={'PATH':'/usr/bin:/bin','LANG':'C'},close_fds=True);send(c,True,'query',p.returncode);return
                if mode=='repository':
                    p=subprocess.run(['/usr/bin/systemd-run','--wait','--pipe','--collect','-p','RuntimeMaxSec=1800','--working-directory=/','--','/usr/bin/pacman',*pacargv],timeout=1860,stdin=subprocess.DEVNULL,stdout=fds[1],stderr=fds[2],env={'PATH':'/usr/bin:/bin','LANG':'C'},close_fds=True)
                    send(c,True,'pacman',p.returncode);return
            if op=='aur-install':
                files=[args[2]] if len(args)==3 and args[0]=='install' else []
                if not files:raise ValueError('invalid AUR install request')
            else: files=args[1:] if args[0]=='-U' else []
            if not files:raise ValueError('package file missing')
            code=0
            for index,source in enumerate(files):
                with PKG_LOCK:
                    rid=secrets.token_hex(16); dest,digest=copy_pkg(source,uid,rid,cwd)
                    try:
                        pkg=pkg_name(dest)
                        expected=req.get('expected_package') if op=='aur-install' else None
                        if op=='aur-install' and expected!=pkg:raise ValueError('package name mismatch')
                        approval='install '+pkg if op=='aur-install' else pkg
                        rate_check(uid)
                        display='Source archive: '+json.dumps(source,ensure_ascii=True)+'; copied package: '+json.dumps(dest,ensure_ascii=True)+'; command: '+json.dumps(['/usr/bin/pacman','--noconfirm','-U','--',dest],ensure_ascii=True,separators=(',',':'))+'; package='+json.dumps(pkg)+'; sha256:'+digest
                        if not popup(escape_display(display),[],approval,timeout_for(open('/proc/cmdline').read())):raise ValueError('package approval refused')
                        # The archive has just received an exact popup approval. Use
                        # noninteractive pacman only after that approval so stdin
                        # from socket activation cannot hang or weaken consent.
                        p=subprocess.run(['/usr/bin/systemd-run','--wait','--pipe','--collect','-p','RuntimeMaxSec=1800','--','/usr/bin/pacman','--noconfirm','-U','--',dest],timeout=1860,stdin=subprocess.DEVNULL,stdout=fds[1],stderr=fds[2],env={'PATH':'/usr/bin:/bin','LANG':'C'},close_fds=True)
                        code=p.returncode
                        if code:break
                    finally:
                        try:os.unlink(dest)
                        except OSError:pass
                        try:os.rmdir(os.path.dirname(dest))
                        except OSError:pass
            send(c,True,'package',code);return
        raise ValueError('unsupported operation')
    except Exception as e:
        try:send(c,False,str(e)[:200])
        except OSError:pass
    finally:
        for fd in fds:
            try:os.close(fd)
            except OSError:pass
        c.close()

def serve(c):
    try:handle(c)
    finally:SLOTS.release()

def main():
    if os.geteuid()!=0 or os.environ.get('LISTEN_PID')!=str(os.getpid()) or os.environ.get('LISTEN_FDS')!='1':return 126
    s=socket.socket(fileno=3);s.settimeout(130)
    while True:
        try:c,_=s.accept()
        except socket.timeout:continue
        if not SLOTS.acquire(blocking=False):
            try:send(c,False,'guard busy')
            except OSError:pass
            c.close();continue
        threading.Thread(target=serve,args=(c,),daemon=True).start()
if __name__=='__main__':sys.exit(main())
