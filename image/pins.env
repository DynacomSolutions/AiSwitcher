# Build pins. Moving any of these is a deliberate commit.
# Arch Linux Archive date: pacman reads the repositories as they were on this day.
ARCH_ARCHIVE_DATE=2026/10/01
# Bootstrap tarball published with the monthly ISO of the same date.
ARCH_BOOTSTRAP_FILE=archlinux-bootstrap-2026.10.01-x86_64.tar.zst
ARCH_BOOTSTRAP_URL=https://archive.archlinux.org/iso/2026.10.01/archlinux-bootstrap-2026.10.01-x86_64.tar.zst
ARCH_BOOTSTRAP_SHA256=0c9c97b7a58a8a023c9e07f84cb307a9e8006e65d8fc4c17b83ddc8010b45c10

# Bundled herdr release asset (Apache-2.0). The binary is checked against the
# digest before it is installed into the image.
HERDR_VERSION=v0.9.3
HERDR_URL=https://github.com/herdrdev/herdr/releases/download/v0.9.3/herdr-linux-x86_64
HERDR_SHA256=18a8dc65f1c2fa485884344356dea1cfd911c6f06cf46fa78e193f4087f4dba7
