#!/usr/bin/bash
set -euo pipefail

fail() { echo "AIS-LIVE-TEST: agent-checks=fail reason=$1" >&2; exit 1; }
[[ "$(/usr/bin/id -un)" == agent ]] || fail wrong-user

if /usr/bin/su -c true root </dev/null >/dev/null 2>&1; then fail su-root; fi
if /usr/bin/su live </dev/null >/dev/null 2>&1; then fail su-live; fi
if /usr/bin/pkexec true </dev/null >/dev/null 2>&1; then fail pkexec; fi
if /usr/bin/nmcli general hostname x >/dev/null 2>&1; then fail network-policy; fi
if /usr/bin/ps -eo user= | /usr/bin/grep -Fxq live; then fail proc-hidepid; fi
live_uid=$(/usr/bin/id -u live)
if [[ -x "/run/user/$live_uid" ]]; then fail herdr-runtime-readable; fi
if /usr/local/bin/herdr api snapshot >/dev/null 2>&1; then fail herdr-api-access; fi

if [[ -f /opt/ais/models/manifest.json ]]; then
  [[ -r /opt/ais/models/model.gguf && ! -w /opt/ais/models/model.gguf ]] || fail model-read-write
  [[ "$(/usr/bin/stat -c '%U:%a' /opt/ais/models/model.gguf)" == root:644 ]] || fail model-owner-mode
  /usr/bin/cat /opt/ais/models/model.gguf >/dev/null || fail model-readable
  if /usr/bin/cat /mnt/aisx/models/model.gguf >/dev/null 2>&1; then fail model-source-isolation; fi
  if printf 'synthetic mutation' >> /opt/ais/models/model.gguf 2>/dev/null; then fail model-write-denied; fi
  if printf 'synthetic mutation' > /opt/ais/models/agent-write-test 2>/dev/null; then fail model-create-denied; fi
  if printf 'synthetic mutation' >> /mnt/aisx/models/model.gguf 2>/dev/null; then fail model-source-write-denied; fi
fi

web_started=false
cleanup() {
  if [[ "$web_started" == true ]]; then /usr/bin/ais web stop >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT
/usr/bin/ais web start >/dev/null 2>&1 || fail console-start
web_started=true
status=''
for _ in {1..40}; do
  status=$(/usr/bin/curl --noproxy '*' --silent --output /dev/null --write-out '%{http_code}' --max-time 2 http://localhost:47129/api/health 2>/dev/null || true)
  [[ "$status" == 401 ]] && break
  /usr/bin/sleep 0.25
done
[[ "$status" == 401 ]] || fail console-token
/usr/bin/ais web stop >/dev/null 2>&1 || fail console-stop
web_started=false

printf 'AIS-LIVE-TEST: agent-checks=ok\n'

if [[ -x /run/ais-live-test/vendor-upgrade ]]; then
  for tool in claude codex grok kimi zai ali pi opencode; do
    shim="/home/agent/.local/bin/$tool"
    [[ -x "$shim" && "$(/usr/bin/stat -c %U "$shim")" == agent ]] || fail "vendor-shim-$tool"
  done
  printf 'AIS-LIVE-TEST: vendor-shims=ok\n'
fi
