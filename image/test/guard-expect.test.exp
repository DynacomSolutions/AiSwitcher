#!/usr/bin/expect -f
set guard_file [lindex $argv 0]
source $guard_file
set sent {}
rename guard_qmp_key guard_qmp_key_real
proc guard_qmp_key {socket text} {
    if {![file exists $socket]} { error "reply attempted before QMP was ready" }
    lappend ::sent [string trim $text]
}

proc run_case {payload expect_success expected_keys} {
    set ::sent {}
    set qmp [file join $::env(AIS_GUARD_TEST_SCRATCH) qmp.sock]
    # Reproduce QEMU's startup: the socket does not exist when spawn returns.
    # It becomes available before the guest can request keyboard input.
    spawn -noecho /bin/sh -c {sleep 0.1; : > "$1"; printf '%s' "$2"} synthetic-guard $qmp $payload
    set serial $spawn_id
    set result [catch {guard_expect_run $serial $qmp 2} message]
    if {$expect_success && $result} { error "expected success, got: $message" }
    if {!$expect_success && !$result} { error "expected failure, got success" }
    if {$::sent ne $expected_keys} { error "unexpected replies: <$::sent>, expected <$expected_keys>" }
    catch {close -i $serial}
    catch {wait -i $serial}
    catch {close $qmp}
    catch {file delete $qmp}
}

set success "AIS-GUARD-TEST: case=unanswered-dd status=popup\nAIS-GUARD-TEST: case=unanswered-dd status=prompt reply=vdb a1b2\nAIS-GUARD-TEST: case=destructive-tool status=popup\nAIS-GUARD-TEST: case=destructive-tool status=prompt reply=vdb c3d4\nAIS-GUARD-TEST: case=raw-read-refusal status=popup\nAIS-GUARD-TEST: case=raw-read-refusal status=prompt reply=vdb e5f6\nAIS-GUARD-TEST: case=wrong-target status=popup\nAIS-GUARD-TEST: case=wrong-target status=prompt reply=vdb 0123\nAIS-GUARD-TEST: case=right-target status=popup\nAIS-GUARD-TEST: case=right-target status=prompt reply=vdb ab12\nAIS-GUARD-TEST: case=symlink-swap status=popup\nAIS-GUARD-TEST: case=symlink-swap status=prompt reply=/dev/loop0 /dev/loop1 3456\nAIS-GUARD-TEST: case=symlink-swap-target-flipped status=ok\nAIS-GUARD-TEST: case=aur-install status=popup\nAIS-GUARD-TEST: case=aur-install status=prompt reply=install synthetic-fixture 6789\nAIS-GUARD-TEST: case=aur-install status=reply\nAIS-GUARD-TEST: case=all status=complete\n"
run_case $success 1 [list wrong-target {vdb ab12} {/dev/loop0 /dev/loop1 3456} {install synthetic-fixture 6789}]
set success_crcrlf [string map [list "\n" "\r\r\n"] $success]
run_case $success_crcrlf 1 [list wrong-target {vdb ab12} {/dev/loop0 /dev/loop1 3456} {install synthetic-fixture 6789}]
run_case "AIS-GUARD-TEST: case=all status=complete\n" 0 {}
run_case "AIS-GUARD-TEST: case=unanswered-dd status=popup\n" 0 {}
run_case "AIS-GUARD-TEST: case=unanswered-dd status=prompt reply=vdb ab12\n" 0 {}
run_case "AIS-GUARD-TEST: case=surprise status=popup\nAIS-GUARD-TEST: case=surprise status=prompt reply=vdb ab12\n" 0 {}
run_case "AIS-GUARD-TEST: case=symlink-swap-target-flipped status=ok\n" 0 {}
run_case "AIS-GUARD-TEST: case=aur-install status=reply\n" 0 {}
run_case "AIS-GUARD-TEST: case=surprise status=popup\n" 0 {}
run_case "AIS-GUARD-TEST: case=symlink-swap status=popup\nAIS-GUARD-TEST: case=symlink-swap-target-flipped status=ok\n" 0 {}
run_case "AIS-GUARD-TEST: case=right-target status=popup\nAIS-GUARD-TEST: case=right-target status=prompt reply=vdb;bad 1234\n" 0 {}
if {![catch {guard_qmp_key_real [file join $::env(AIS_GUARD_TEST_SCRATCH) missing.qmp] vdb} message]
    || $message ne "QMP socket unavailable"} {
    error "missing QMP socket did not fail at reply time"
}
puts "guard Expect driver tests passed"
