# Example values for the k8s/*.yaml envsubst templates in this directory.
#
# These manifests are consumer-supplied templates: they contain NO real
# hostnames, domains, node names, or filesystem paths. Every concrete value
# is provided by whoever deploys AIS, typically from a private cluster repo
# that is not part of this project.
#
# Usage (envsubst or an equivalent templating step is expected to already be
# part of your deploy pipeline):
#   set -a; source k8s/example.env; set +a
#   for f in k8s/deployment.yaml k8s/service.yaml k8s/mapping.yaml; do
#     envsubst < "$f" | kubectl apply -f -
#   done
#
# Replace every value below with your own before using it for a real
# deployment. Nothing here needs to resolve or exist.

# Image name/tag and target namespace.
PROJECT=ais
TAG=latest
AIS_NAMESPACE=example-namespace

# Container port the app listens on.
PORT=47129

# Registry the built image is pushed to and pulled from.
AIS_IMAGE_REGISTRY=registry.example.com

# Comma-separated vhostnames the web guard trusts (AIS_WEB_ALLOWED_HOSTS).
AIS_WEB_ALLOWED_HOSTS=ais.example.com

# Public hostnames for the optional ingress Mappings.
AIS_PUBLIC_HOSTNAME=ais.example.com
AIS_ALIBABA_PUBLIC_HOSTNAME=ais-alibaba.example.com

# Node to pin the pod to when the hostPath data below only exists on one
# host. Leave empty and drop the nodeSelector block in k8s/deployment.yaml
# if every node in your cluster can see the same data.
AIS_NODE_HOSTNAME=example-node

# Home directory inside the container (must match the image's HOME, see
# the Dockerfile) and on the host the hostPath volumes are mounted from.
# Registries store host paths; the container translates AIS_HOST_HOME to its home.
AIS_CONTAINER_HOME=/home/ais
AIS_HOST_HOME=/home/example

# Host directory containing kubeconfig, mounted read-only at
# ${AIS_CONTAINER_HOME}/.kube (see k8s/deployment.yaml for why the mount
# target matters if ~/.kube/config is a symlink).
AIS_HOST_KUBE_DIR=/home/ais/.kube

# Kubernetes namespace where the interactive auth browser service
# (chrome-auth-<identity>) is deployed. Leave empty to use the default.
AIS_AUTH_BROWSER_NAMESPACE=chrome-mcp
