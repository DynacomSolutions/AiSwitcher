{
  "name": "ai-profile-switcher",
  "type": "module",
  "version": "0.5.43",
  "scripts": {
    "test": "bun test",
    "test:e2e": "bun test ./apps/chrome-extension/test/e2e/extension.e2e.ts",
    "test:e2e:web": "bun test ./apps/web/test/mobile-layout.e2e.ts",
    "privacy:check": "bun run scripts/privacy-check.ts",
    "privacy:install": "bun run scripts/install-privacy-hooks.ts",
    "identifiers:check": "bun run scripts/identifier-scan.ts",
    "secrets:check": "bun run scripts/secret-scan.ts",
    "host:check-contract": "bun run scripts/host/check-contract.ts",
    "host:test-ssh": "bun run scripts/host/test-ssh.ts",
    "lint": "bun run scripts/identifier-scan.ts --tree && bun run scripts/secret-scan.ts --tree",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/chrome-extension/tsconfig.json",
    "build": "bun run scripts/build.ts",
    "backup": "bun run scripts/backup.ts",
    "migrate": "bun run scripts/migrate.ts",
    "install:shims": "bun run scripts/install.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/bun": "^1.3.14",
    "@types/chrome": "0.3.7",
    "openai": "7.47.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.1129.0",
    "@aws-sdk/client-cost-explorer": "^3.1129.0",
    "@aws-sdk/credential-providers": "^3.1129.0",
    "@clack/core": "^1.4.2",
    "@clack/prompts": "^1.0.0",
    "hono": "^4.13.5",
    "smol-toml": "^1.8.0"
  }
}
