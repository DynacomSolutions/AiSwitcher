+    /// AIS: commit the entries parsed so far in the middle of a scan, so a
+    /// scan that is killed later (a timeout, a restart) keeps them and the
+    /// next scan continues from there. It is the same locked, atomic
+    /// per-shard transaction as the final save, but it never publishes a
+    /// scope seed: only the final save has looked up every entry the seed
+    /// must carry (retained Claude history comes last). Returns whether
+    /// anything was written.
+    pub(crate) fn save_checkpoint(&mut self) -> bool {
+        let state = self.state.get_mut().unwrap_or_else(|p| p.into_inner());
+        if state.dirty_keys.is_empty() && state.deleted_keys.is_empty() {
+            return false;
+        }
+        self.save_if_dirty_with_options(MAX_CACHE_SHARD_BYTES, false);
+        true
+    }
+
     fn save_if_dirty_with_limit(&mut self, max_shard_bytes: u64) {
+        self.save_if_dirty_with_options(max_shard_bytes, true);
+    }
