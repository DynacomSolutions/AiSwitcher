+    fn ais_checkpoint_writes_scoped_entries_without_publishing_the_seed() {
+        let dir = TempDir::new().unwrap();
+        let _env = sandbox_cache_env(dir.path());
+        let identity = CacheIdentity::for_client(ClientId::Codex);
+        let a = dir.path().join("identity").join("rollout-a.jsonl");
+        let b = dir.path().join("identity").join("rollout-b.jsonl");
+        std::fs::create_dir_all(a.parent().unwrap()).unwrap();
+        for path in [&a, &b] {
+            std::fs::write(path, b"{}\n").unwrap();
+        }
+        let mut shared = SourceMessageCache::load();
+        shared.insert(test_entry(identity, &b, "b"));
+        shared.save_if_dirty();
+
+        ais_scope_set(Some("0c"));
+        let mut scan = SourceMessageCache::load();
+        assert!(
+            !scan.save_checkpoint(),
+            "nothing parsed yet, nothing to write"
+        );
+        scan.insert(test_entry(identity, &a, "a"));
+        assert!(scan.save_checkpoint());
+        let scoped_dir = scoped_shard_dir("0c").unwrap().join(identity.namespace);
+        assert_eq!(ais_scope_entries("0c", identity.namespace), vec![a.clone()]);
+        assert!(!scoped_dir.join(AIS_SCOPE_SEEDED_MARKER).exists());
+        assert!(
+            !scan.save_checkpoint(),
+            "a committed checkpoint leaves nothing dirty"
+        );
+
+        // Later in the same scan a shared entry is looked up; the final save
+        // carries it over and only then publishes the seed.
+        assert!(scan.take(identity, &b).is_some());
+        scan.save_if_dirty();
+        assert!(scoped_dir.join(AIS_SCOPE_SEEDED_MARKER).is_file());
+        let mut entries = ais_scope_entries("0c", identity.namespace);
+        entries.sort();
+        assert_eq!(entries, vec![a.clone(), b.clone()]);
+        ais_scope_set(None);
+    }
