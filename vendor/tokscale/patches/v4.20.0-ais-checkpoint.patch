+/// AIS: message-cache checkpoints during a long local scan.
+///
+/// The cache is otherwise written once, after every source was parsed. A cold
+/// scan of a large home under a disk-bandwidth cap can outlive the caller's
+/// timeout; the kill then discarded everything it had parsed and the next scan
+/// started from nothing again. With `TOKSCALE_AIS_CHECKPOINT_SECS=<n>` the
+/// Claude and Codex lanes parse their sources in chunks and, at least `n`
+/// seconds after the previous checkpoint, commit the new entries with
+/// [`message_cache::SourceMessageCache::save_checkpoint`]. A killed scan keeps
+/// what it committed and the next scan reads those sources as cache hits, so
+/// it continues where the last one stopped. The parsed messages and the order
+/// they are merged in are unchanged; only the cache write happens earlier.
+///
+/// The interval also stretches to [`AIS_CHECKPOINT_COST_FACTOR`] times the
+/// last checkpoint's own duration: a checkpoint rewrites every shard its new
+/// entries fall into, so this keeps checkpoint writes to a bounded share of
+/// the scan however large the cache grows.
+struct AisCacheCheckpoint {
+    interval: Option<std::time::Duration>,
+    last: Instant,
+    last_cost: std::time::Duration,
+}
+
+/// Sources parsed between two checkpoint opportunities.
+const AIS_CHECKPOINT_CHUNK_SOURCES: usize = 64;
+const AIS_CHECKPOINT_COST_FACTOR: u32 = 4;
+
+#[cfg(test)]
+const AIS_CHECKPOINT_ABORT_AFTER_ENV: &str = "TOKSCALE_TEST_AIS_CHECKPOINT_ABORT_AFTER";
+#[cfg(test)]
+static AIS_CHECKPOINT_WRITES: std::sync::atomic::AtomicUsize =
+    std::sync::atomic::AtomicUsize::new(0);
+
+impl AisCacheCheckpoint {
+    fn from_env(policy: SourceCachePolicy) -> Self {
+        let interval = (policy != SourceCachePolicy::InMemory)
+            .then(|| std::env::var("TOKSCALE_AIS_CHECKPOINT_SECS").ok())
+            .flatten()
+            .and_then(|value| value.trim().parse::<u64>().ok())
+            .map(std::time::Duration::from_secs);
+        Self {
+            interval,
+            last: Instant::now(),
+            last_cost: std::time::Duration::ZERO,
+        }
+    }
+
+    fn chunk_sources(&self) -> usize {
+        #[cfg(test)]
+        if let Some(size) = std::env::var("TOKSCALE_TEST_AIS_CHECKPOINT_CHUNK")
+            .ok()
+            .and_then(|value| value.parse::<usize>().ok())
+            .filter(|size| *size > 0)
+        {
+            return size;
+        }
+        AIS_CHECKPOINT_CHUNK_SOURCES
+    }
+
+    fn maybe_save(&mut self, source_cache: &mut message_cache::SourceMessageCache) {
+        let Some(interval) = self.interval else {
+            return;
+        };
+        let started = Instant::now();
+        let elapsed = started.saturating_duration_since(self.last);
+        if elapsed < interval || elapsed < self.last_cost * AIS_CHECKPOINT_COST_FACTOR {
+            return;
+        }
+        if !source_cache.save_checkpoint() {
+            return;
+        }
+        self.last = Instant::now();
+        self.last_cost = self.last.saturating_duration_since(started);
+        #[cfg(test)]
+        {
+            let writes =
+                AIS_CHECKPOINT_WRITES.fetch_add(1, std::sync::atomic::Ordering::SeqCst) + 1;
+            if std::env::var(AIS_CHECKPOINT_ABORT_AFTER_ENV)
+                .ok()
+                .and_then(|value| value.parse::<usize>().ok())
+                == Some(writes)
+            {
+                // Stands in for the caller's timeout kill right after a checkpoint.
+                std::process::abort();
+            }
+        }
+    }
+}
+
+/// Map `items` in parallel, as `par_iter().map().collect()` does. With
+/// checkpoints enabled the items run in chunks; after each chunk `stash` moves
+/// every outcome's cache update into `source_cache` (leaving nothing for the
+/// caller's own insert) and a checkpoint may commit it.
+fn ais_checkpointed_par_map<P: Sync, T: Send>(
+    items: &[P],
+    source_cache: &mut message_cache::SourceMessageCache,
+    checkpoint: &mut AisCacheCheckpoint,
+    map: impl Fn(&P, &message_cache::SourceMessageCache) -> T + Sync + Send,
+    mut stash: impl FnMut(&mut T, &mut message_cache::SourceMessageCache),
+) -> Vec<T> {
+    if checkpoint.interval.is_none() {
+        let cache = &*source_cache;
+        return items.par_iter().map(|item| map(item, cache)).collect();
+    }
+    let mut outcomes = Vec::with_capacity(items.len());
+    for chunk in items.chunks(checkpoint.chunk_sources()) {
+        let cache = &*source_cache;
+        let mut chunk_outcomes: Vec<T> = chunk.par_iter().map(|item| map(item, cache)).collect();
+        for outcome in &mut chunk_outcomes {
+            stash(outcome, source_cache);
+        }
+        outcomes.extend(chunk_outcomes);
+        checkpoint.maybe_save(source_cache);
+    }
+    outcomes
+}
