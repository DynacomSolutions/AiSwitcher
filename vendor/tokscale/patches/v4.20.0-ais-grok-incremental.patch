+#[derive(serde::Serialize, serde::Deserialize)]
+struct UnifiedCheckpoint {
+    version: u32,
+    /// Bytes of the log the state covers; ends just after a newline.
+    offset: u64,
+    inode: u64,
+    digest: u64,
+    scan_generations: Vec<(i64, UnifiedGeneration)>,
+    evidence: EvidenceWire,
+    parse_generations: Vec<(i64, UnifiedGeneration)>,
+    fallback_model_by_pid: Vec<(i64, UnifiedGeneration, String)>,
+    model_by_pid_and_session: Vec<(i64, UnifiedGeneration, String, String)>,
+    model_by_session: Vec<(String, String)>,
+    message_count: u64,
+    message_hash: u64,
+    /// Hash of the fingerprint the cached entry of this parse carries.
+    fingerprint_hash: u64,
+    sessions: Vec<SessionWire>,
+}
+
+fn fingerprint_hash(fingerprint: &crate::message_cache::SourceFingerprint) -> Option<u64> {
+    Some(fnv_update(
+        FNV_OFFSET,
+        &bincode::serialize(fingerprint).ok()?,
+    ))
+}
+
+fn fnv_update(mut hash: u64, bytes: &[u8]) -> u64 {
+    for byte in bytes {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    hash
+}
+
+const FNV_OFFSET: u64 = 0xcbf2_9ce4_8422_2325;
+
+fn messages_hash<'a>(messages: impl Iterator<Item = &'a UnifiedMessage>) -> u64 {
+    let mut hash = FNV_OFFSET;
+    for message in messages {
+        let key = message.dedup_key.as_deref().unwrap_or("");
+        hash = fnv_update(hash, key.as_bytes());
+        hash = fnv_update(hash, &[0xff]);
+    }
+    hash
+}
+
+fn log_inode(file: &std::fs::File) -> u64 {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        file.metadata().map(|metadata| metadata.ino()).unwrap_or(0)
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = file;
+        0
+    }
+}
+
+fn read_window(file: &mut std::fs::File, start: u64, len: u64) -> Option<Vec<u8>> {
+    file.seek(SeekFrom::Start(start)).ok()?;
+    let mut buffer = vec![0; usize::try_from(len).ok()?];
+    CountedRead(&mut *file).read_exact(&mut buffer).ok()?;
+    Some(buffer)
+}
+
+/// A sampled digest of the first `offset` bytes: the offset, the first 64 KiB
+/// and the 64 KiB before the offset.
+fn prefix_digest(file: &mut std::fs::File, offset: u64) -> Option<u64> {
+    let window = CHECKPOINT_WINDOW.min(offset);
+    let mut hash = fnv_update(FNV_OFFSET, &offset.to_le_bytes());
+    hash = fnv_update(hash, &read_window(file, 0, window)?);
+    hash = fnv_update(hash, &read_window(file, offset - window, window)?);
+    Some(hash)
+}
+
+/// The length of the complete-line prefix of the first `len` bytes: it ends
+/// just after the last newline. A final line without one is still being
+/// written and counts once its newline arrives.
+fn complete_line_prefix(file: &mut std::fs::File, len: u64) -> u64 {
+    let mut end = len;
+    while end > 0 {
+        let start = end.saturating_sub(CHECKPOINT_WINDOW);
+        let Some(chunk) = read_window(file, start, end - start) else {
+            return 0;
+        };
+        if let Some(position) = chunk.iter().rposition(|byte| *byte == b'\n') {
+            return start + position as u64 + 1;
+        }
+        end = start;
+    }
+    0
+}
+
+fn checkpoint_path(log: &Path) -> Option<PathBuf> {
+    let name = fnv_update(FNV_OFFSET, log.to_string_lossy().as_bytes());
+    Some(
+        crate::message_cache::cache_dir()?
+            .join(CHECKPOINT_DIRNAME)
+            .join(format!("{name:016x}.bin")),
+    )
+}
+
+fn load_checkpoint(log: &Path) -> Option<UnifiedCheckpoint> {
+    let bytes = std::fs::read(checkpoint_path(log)?).ok()?;
+    let checkpoint: UnifiedCheckpoint = bincode::deserialize(&bytes).ok()?;
+    (checkpoint.version == CHECKPOINT_VERSION).then_some(checkpoint)
+}
+
+fn remove_checkpoint(log: &Path) {
+    if let Some(path) = checkpoint_path(log) {
+        let _ = std::fs::remove_file(path);
+    }
+}
+
+fn write_checkpoint(log: &Path, checkpoint: &UnifiedCheckpoint) {
+    let Some(path) = checkpoint_path(log) else {
+        return;
+    };
+    let Ok(bytes) = bincode::serialize(checkpoint) else {
+        return;
+    };
+    let Some(dir) = path.parent() else { return };
+    if std::fs::create_dir_all(dir).is_err() {
+        return;
+    }
+    let nanos = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|elapsed| elapsed.as_nanos())
+        .unwrap_or(0);
+    let temp = dir.join(format!(".{}.{nanos}.tmp", std::process::id()));
+    if std::fs::write(&temp, bytes).is_err() || std::fs::rename(&temp, &path).is_err() {
+        let _ = std::fs::remove_file(&temp);
+    }
+}
+
+fn sorted<T: Ord>(mut values: Vec<T>) -> Vec<T> {
+    values.sort();
+    values
+}
+
+fn build_checkpoint(
+    file: &mut std::fs::File,
+    offset: u64,
+    scan_generations: &HashMap<i64, UnifiedGeneration>,
+    evidence: &UnifiedChildEvidence,
+    state: &UnifiedParseState,
+    message_count: u64,
+    message_hash: u64,
+    fingerprint_hash: u64,
+    sessions: Vec<SessionWire>,
+) -> Option<UnifiedCheckpoint> {
+    Some(UnifiedCheckpoint {
+        version: CHECKPOINT_VERSION,
+        offset,
+        inode: log_inode(file),
+        digest: prefix_digest(file, offset)?,
+        scan_generations: sorted(scan_generations.iter().map(|(k, v)| (*k, *v)).collect()),
+        evidence: evidence.into(),
+        parse_generations: sorted(state.generations.iter().map(|(k, v)| (*k, *v)).collect()),
+        fallback_model_by_pid: sorted(
+            state
+                .fallback_model_by_pid
+                .iter()
+                .map(|((pid, generation), model)| (*pid, *generation, model.clone()))
+                .collect(),
+        ),
+        model_by_pid_and_session: sorted(
+            state
+                .model_by_pid_and_session
+                .iter()
+                .map(|((pid, generation, sid), model)| {
+                    (*pid, *generation, sid.clone(), model.clone())
+                })
+                .collect(),
+        ),
+        model_by_session: sorted(
+            state
+                .model_by_session
+                .iter()
+                .map(|(sid, model)| (sid.clone(), model.clone()))
+                .collect(),
+        ),
+        message_count,
+        message_hash,
+        fingerprint_hash,
+        sessions,
+    })
+}
+
+/// The checkpoint when it still describes the start of `file`: same inode,
+/// same sampled prefix, not past the complete-line prefix of the file.
+fn valid_checkpoint(
+    log: &Path,
+    file: &mut std::fs::File,
+    complete: u64,
+) -> Option<UnifiedCheckpoint> {
+    let checkpoint = load_checkpoint(log)?;
+    let valid = checkpoint.offset <= complete
+        && checkpoint.inode == log_inode(file)
+        && prefix_digest(file, checkpoint.offset) == Some(checkpoint.digest);
+    valid.then_some(checkpoint)
+}
+
+/// The evidence of the complete lines of the first `log_len` bytes (reading
+/// only the bytes after a valid checkpoint), and the evidence with a final
+/// unterminated line added when there is one. The fingerprint and the parse
+/// both use it.
+struct UnifiedEvidenceScan {
+    /// Up to the last newline.
+    complete: UnifiedChildEvidence,
+    generations: HashMap<i64, UnifiedGeneration>,
+    complete_len: u64,
+    /// Including the unterminated last line; `None` when there is none.
+    with_tail: Option<UnifiedChildEvidence>,
+}
+
+impl UnifiedEvidenceScan {
+    fn full(&self) -> &UnifiedChildEvidence {
+        self.with_tail.as_ref().unwrap_or(&self.complete)
+    }
+}
+
+fn scan_unified_evidence(
+    log: &Path,
+    file: &mut std::fs::File,
+    log_len: u64,
+) -> Option<UnifiedEvidenceScan> {
+    let complete_len = complete_line_prefix(file, log_len);
+    let (mut evidence, mut generations, start) = match valid_checkpoint(log, file, complete_len) {
+        Some(checkpoint) => (
+            checkpoint.evidence.into(),
+            checkpoint.scan_generations.into_iter().collect(),
+            checkpoint.offset,
+        ),
+        None => (UnifiedChildEvidence::default(), HashMap::new(), 0),
+    };
+    file.seek(SeekFrom::Start(start)).ok()?;
+    collect_unified_child_evidence_into(
+        BufReader::new(CountedRead(&mut *file)).take(complete_len - start),
+        &mut evidence,
+        &mut generations,
+    );
+    let with_tail = if log_len > complete_len {
+        let mut full = evidence.clone();
+        let mut full_generations = generations.clone();
+        file.seek(SeekFrom::Start(complete_len)).ok()?;
+        collect_unified_child_evidence_into(
+            BufReader::new(CountedRead(&mut *file)).take(log_len - complete_len),
+            &mut full,
+            &mut full_generations,
+        );
+        Some(full)
+    } else {
+        None
+    };
+    Some(UnifiedEvidenceScan {
+        complete: evidence,
+        generations,
+        complete_len,
+        with_tail,
+    })
+}
+
+/// The messages of a final line without a newline, parsed against the state
+/// after the complete lines. They are returned but never checkpointed: the
+/// next scan reads that line again once its newline has arrived.
+fn parse_unterminated_tail(
+    file: &mut std::fs::File,
+    complete_len: u64,
+    log_len: u64,
+    state: &mut UnifiedParseState,
+    evidence: &UnifiedChildEvidence,
+    metadata_by_session: &HashMap<String, GrokMetadata>,
+    fallback_timestamp: i64,
+) -> Option<()> {
+    if log_len <= complete_len {
+        return Some(());
+    }
+    file.seek(SeekFrom::Start(complete_len)).ok()?;
+    for line in lossy_lines(BufReader::new(CountedRead(&mut *file)).take(log_len - complete_len)) {
+        state.process_line(&line, evidence, metadata_by_session, fallback_timestamp);
+    }
+    Some(())
+}
+
+/// AIS: the parse of a unified log that also leaves a checkpoint behind.
+pub(crate) fn parse_grok_unified_log_checkpointed(
+    path: &Path,
+    fingerprint: Option<&crate::message_cache::SourceFingerprint>,
+) -> Vec<UnifiedMessage> {
+    if path.file_name().and_then(|name| name.to_str()) != Some("unified.jsonl") {
+        return parse_grok_file(path);
+    }
+    let Ok(mut file) = std::fs::File::open(path) else {
+        return Vec::new();
+    };
+    let log_len = file.metadata().map(|metadata| metadata.len()).unwrap_or(0);
+    #[cfg(test)]
+    GROK_UNIFIED_PARSED_PATHS
+        .lock()
+        .unwrap()
+        .push(path.to_path_buf());
+    let fallback_timestamp = file_modified_timestamp_ms(path);
+    let complete_len = complete_line_prefix(&mut file, log_len);
+    let mut evidence = UnifiedChildEvidence::default();
+    let mut scan_generations = HashMap::new();
+    if file.seek(SeekFrom::Start(0)).is_err() {
+        return Vec::new();
+    }
+    collect_unified_child_evidence_into(
+        BufReader::new(CountedRead(&mut file)).take(log_len),
+        &mut evidence,
+        &mut scan_generations,
+    );
+    // Evidence of the complete lines alone, to know if the tail adds any.
+    let mut complete_evidence = UnifiedChildEvidence::default();
+    let mut complete_generations = HashMap::new();
+    if log_len > complete_len {
+        if file.seek(SeekFrom::Start(0)).is_err() {
+            return Vec::new();
+        }
+        collect_unified_child_evidence_into(
+            BufReader::new(CountedRead(&mut file)).take(complete_len),
+            &mut complete_evidence,
+            &mut complete_generations,
+        );
+    } else {
+        complete_evidence = evidence.clone();
+        complete_generations = scan_generations.clone();
+    }
+    if file.seek(SeekFrom::Start(0)).is_err() {
+        return Vec::new();
+    }
+    let metadata_by_session = read_unified_session_metadata(path, &evidence.referenced_session_ids);
+    let mut state = UnifiedParseState::default();
+    for line in lossy_lines(BufReader::new(CountedRead(&mut file)).take(complete_len)) {
+        state.process_line(&line, &evidence, &metadata_by_session, fallback_timestamp);
+    }
+    let complete_flag = state.used_fallback_timestamp;
+    let complete_message_count = state.messages.len();
+    let mut checkpoint = None;
+    if !complete_flag && without_refs(&evidence) == without_refs(&complete_evidence) {
+        if let Some(fingerprint_hash) = fingerprint.and_then(fingerprint_hash) {
+            let mut sessions: Vec<SessionWire> = complete_evidence
+                .referenced_session_ids
+                .iter()
+                .map(|sid| SessionWire::from_metadata(sid, metadata_by_session.get(sid)))
+                .collect();
+            sessions.sort_by(|a, b| a.session_id.cmp(&b.session_id));
+            checkpoint = build_checkpoint(
+                &mut file,
+                complete_len,
+                &complete_generations,
+                &complete_evidence,
+                &state,
+                complete_message_count as u64,
+                messages_hash(state.messages.iter()),
+                fingerprint_hash,
+                sessions,
+            );
+        }
+    }
+    match checkpoint {
+        Some(checkpoint) => write_checkpoint(path, &checkpoint),
+        None => remove_checkpoint(path),
+    }
+    if parse_unterminated_tail(
+        &mut file,
+        complete_len,
+        log_len,
+        &mut state,
+        &evidence,
+        &metadata_by_session,
+        fallback_timestamp,
+    )
+    .is_none()
+    {
+        remove_checkpoint(path);
+    }
+    state.messages
+}
+
+fn without_refs(evidence: &UnifiedChildEvidence) -> UnifiedChildEvidence {
+    let mut copy = evidence.clone();
+    copy.referenced_session_ids.clear();
+    copy
+}
+
+/// The session ids whose files differ between two fingerprints of the same
+/// unified log (changed, added or removed).
+fn changed_session_ids(
+    old: &crate::message_cache::SourceFingerprint,
+    new: &crate::message_cache::SourceFingerprint,
+) -> HashSet<String> {
+    fn session_of(suffix: &str) -> Option<&str> {
+        let rest = suffix
+            .strip_prefix("sessions-session:")
+            .or_else(|| suffix.strip_prefix("sessions-file:"))?;
+        // `sessions/<workspace>/<session>[/<file>]`
+        rest.split('/').nth(2)
+    }
+    let mut changed = HashSet::new();
+    let old_by_suffix: HashMap<&str, _> = old
+        .related_files
+        .iter()
+        .map(|related| (related.suffix.as_str(), related))
+        .collect();
+    let new_by_suffix: HashMap<&str, _> = new
+        .related_files
+        .iter()
+        .map(|related| (related.suffix.as_str(), related))
+        .collect();
+    for (suffix, related) in &old_by_suffix {
+        if new_by_suffix.get(suffix) != Some(related) {
+            changed.extend(session_of(suffix).map(str::to_string));
+        }
+    }
+    for suffix in new_by_suffix.keys() {
+        if !old_by_suffix.contains_key(suffix) {
+            changed.extend(session_of(suffix).map(str::to_string));
+        }
+    }
+    changed
+}
