+    /// A grown unified log is read from its checkpoint: every cycle returns
+    /// the messages of a cold full read, and a warm cycle reads only the
+    /// appended bytes. A partial last line, a truncated or replaced log, new
+    /// subagent evidence and a changed session fall back to the full parse.
+    #[test]
+    #[serial_test::serial]
+    fn ais_grok_incremental_log_matches_full_read_and_reads_only_new_bytes() {
+        use std::sync::atomic::Ordering;
+        let cache_home = tempfile::TempDir::new().unwrap();
+        let home = tempfile::TempDir::new().unwrap();
+        let sessions = home.path().join(".grok/sessions/%2Ftmp%2Fa");
+        ais_grok_session(&sessions.join("s1"), "grok-code", None);
+        ais_grok_session(&sessions.join("s2"), "grok-4", None);
+        let logs = home.path().join(".grok/logs");
+        std::fs::create_dir_all(&logs).unwrap();
+        let unified = logs.join("unified.jsonl");
+        let scan = |home: &std::path::Path| {
+            ais_grok_rows(&parse_all_messages_with_pricing_with_env_strategy(
+                home.to_str().unwrap(),
+                &["grok".to_string()],
+                None,
+                false,
+                &scanner::ScannerSettings::default(),
+            ))
+        };
+        let cold = |home: &std::path::Path| {
+            let fresh_cache = tempfile::TempDir::new().unwrap();
+            let _env = redirect_cache_home(fresh_cache.path());
+            scan(home)
+        };
+        let bytes = || GROK_BYTES.load(Ordering::Relaxed);
+        use sessions::grok::GROK_UNIFIED_BYTES_READ as GROK_BYTES;
+        let tick = || std::thread::sleep(std::time::Duration::from_millis(30));
+
+        let mut next = 0u32;
+        let mut chunk = |rows: u32| {
+            let mut text = String::new();
+            for _ in 0..rows {
+                text.push_str(&ais_grok_row(next));
+                next += 1;
+            }
+            text
+        };
+        std::fs::write(&unified, chunk(30000)).unwrap();
+        let env = redirect_cache_home(cache_home.path());
+        let before = bytes();
+        let first = scan(home.path());
+        let full_read = bytes() - before;
+        assert_eq!(first.len(), 30000);
+        drop(env);
+        assert_eq!(first, cold(home.path()), "first scan");
+        let log_size = std::fs::metadata(&unified).unwrap().len();
+
+        // Several appended chunks: equal totals, only new bytes read.
+        for round in 0..3 {
+            tick();
+            ais_incremental_append(&unified, &chunk(5));
+            let env = redirect_cache_home(cache_home.path());
+            let before = bytes();
+            let warm = scan(home.path());
+            let read = bytes() - before;
+            drop(env);
+            assert_eq!(warm.len(), 30000 + 5 * (round + 1));
+            assert_eq!(warm, cold(home.path()), "append round {round}");
+            assert!(
+                read * 20 < full_read,
+                "round {round}: read {read} bytes, a full read is {full_read}"
+            );
+            eprintln!(
+                "AIS_GROK_INCREMENTAL log={log_size} full_read_per_cycle={full_read} incremental_read_per_cycle={read}"
+            );
+        }
+
+        // A partial last line is not counted until its newline arrives.
+        tick();
+        let row = chunk(1);
+        let (head, rest) = row.split_at(row.len() / 2);
+        ais_incremental_append(&unified, head);
+        let env = redirect_cache_home(cache_home.path());
+        let with_partial = scan(home.path());
+        drop(env);
+        assert_eq!(with_partial.len(), 30015);
+        assert_eq!(with_partial, cold(home.path()), "partial line");
+        tick();
+        ais_incremental_append(&unified, rest);
+        let env = redirect_cache_home(cache_home.path());
+        let completed = scan(home.path());
+        drop(env);
+        assert_eq!(completed.len(), 30016);
+        assert_eq!(completed, cold(home.path()), "completed line");
+
+        // A truncated log, and a replaced log that is larger than the old one.
+        for (label, contents) in [("truncated", chunk(40)), ("replaced", chunk(30500))] {
+            tick();
+            std::fs::write(&unified, &contents).unwrap();
+            let env = redirect_cache_home(cache_home.path());
+            let warm = scan(home.path());
+            drop(env);
+            assert_eq!(warm, cold(home.path()), "{label}");
+        }
+        // A rotation: a new file at the same path.
+        tick();
+        std::fs::rename(&unified, logs.join("unified.old")).unwrap();
+        std::fs::write(&unified, chunk(30500)).unwrap();
+        let env = redirect_cache_home(cache_home.path());
+        let rotated = scan(home.path());
+        drop(env);
+        assert_eq!(rotated, cold(home.path()), "rotated");
+
+        // New subagent evidence changes earlier attribution: full parse.
+        tick();
+        ais_incremental_append(
+            &unified,
+            "{\"ts\":\"2026-11-01T00:01:00Z\",\"pid\":11,\"msg\":\"subagent spawn credentials\",\"ctx\":{\"subagent_id\":\"s2\",\"model\":\"grok-5\"}}\n",
+        );
+        ais_incremental_append(&unified, &chunk(3));
+        let env = redirect_cache_home(cache_home.path());
+        let with_evidence = scan(home.path());
+        drop(env);
+        assert_eq!(with_evidence, cold(home.path()), "subagent evidence");
+
+        // A session an earlier row used changes its model: full parse.
+        tick();
+        ais_grok_session(&sessions.join("s1"), "grok-5", None);
+        ais_incremental_append(&unified, &chunk(3));
+        let env = redirect_cache_home(cache_home.path());
+        let changed = scan(home.path());
+        drop(env);
+        assert_eq!(changed, cold(home.path()), "session metadata change");
+
+        // After a fallback the next cycle is incremental again.
+        tick();
+        ais_incremental_append(&unified, &chunk(4));
+        let env = redirect_cache_home(cache_home.path());
+        let before = bytes();
+        let again = scan(home.path());
+        let read = bytes() - before;
+        drop(env);
+        assert_eq!(again, cold(home.path()), "after fallback");
+        assert!(read * 10 < std::fs::metadata(&unified).unwrap().len() * 3);
+    }
