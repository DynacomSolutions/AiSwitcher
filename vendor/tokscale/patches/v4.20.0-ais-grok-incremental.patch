+/// AIS: continue the parse of a grown unified log from its checkpoint.
+/// `cached` holds the messages the previous scan cached for the log. Returns
+/// every message a full parse gives, reading only the appended bytes, or
+/// `None` when only a full parse is safe.
+pub(crate) fn resume_grok_unified_log(
+    path: &Path,
+    cached: &[UnifiedMessage],
+    old_fingerprint: &crate::message_cache::SourceFingerprint,
+    new_fingerprint: &crate::message_cache::SourceFingerprint,
+) -> Option<Vec<UnifiedMessage>> {
+    if path.file_name().and_then(|name| name.to_str()) != Some("unified.jsonl") {
+        return None;
+    }
+    let mut file = std::fs::File::open(path).ok()?;
+    let log_len = file.metadata().ok()?.len();
+    let complete_len = complete_line_prefix(&mut file, log_len);
+    let checkpoint = valid_checkpoint(path, &mut file, complete_len)?;
+    if fingerprint_hash(old_fingerprint)? != checkpoint.fingerprint_hash {
+        return None;
+    }
+    let new_fingerprint_hash = fingerprint_hash(new_fingerprint)?;
+    let count = usize::try_from(checkpoint.message_count).ok()?;
+    let old = cached.get(..count)?;
+    if messages_hash(old.iter()) != checkpoint.message_hash {
+        return None;
+    }
+
+    let old_evidence: UnifiedChildEvidence = checkpoint.evidence.into();
+    let scan = scan_unified_evidence(path, &mut file, log_len)?;
+    // Appended subagent evidence can change how earlier rows are attributed.
+    let old_plain = without_refs(&old_evidence);
+    if without_refs(&scan.complete) != old_plain || without_refs(scan.full()) != old_plain {
+        return None;
+    }
+    let evidence = scan.full();
+
+    // Sessions to read again: new ones, ones that were missing, and ones whose
+    // files changed. Every other session keeps the metadata of its last read.
+    let stored: HashMap<String, SessionWire> = checkpoint
+        .sessions
+        .into_iter()
+        .map(|wire| (wire.session_id.clone(), wire))
+        .collect();
+    let mut to_read: HashSet<String> = evidence
+        .referenced_session_ids
+        .difference(&old_evidence.referenced_session_ids)
+        .cloned()
+        .collect();
+    to_read.extend(
+        stored
+            .values()
+            .filter(|wire| !wire.found)
+            .map(|wire| wire.session_id.clone()),
+    );
+    to_read.extend(
+        changed_session_ids(old_fingerprint, new_fingerprint)
+            .into_iter()
+            .filter(|sid| stored.contains_key(sid)),
+    );
+    let fresh = read_unified_session_metadata(path, &to_read);
+    let mut metadata_by_session: HashMap<String, GrokMetadata> = stored
+        .values()
+        .filter(|wire| !to_read.contains(&wire.session_id))
+        .filter_map(|wire| wire.metadata().map(|m| (wire.session_id.clone(), m)))
+        .collect();
+    for sid in &to_read {
+        let wire = SessionWire::from_metadata(sid, fresh.get(sid));
+        // A session earlier rows already used must give the same.
+        if stored.get(sid).is_some_and(|previous| previous != &wire) {
+            return None;
+        }
+        if let Some(metadata) = fresh.get(sid) {
+            metadata_by_session.insert(sid.clone(), metadata.clone());
+        }
+    }
+    let mut sessions: Vec<SessionWire> = Vec::new();
+    for sid in &scan.complete.referenced_session_ids {
+        sessions.push(match stored.get(sid) {
+            Some(wire) if !to_read.contains(sid) => wire.clone(),
+            _ => SessionWire::from_metadata(sid, fresh.get(sid)),
+        });
+    }
+    sessions.sort_by(|a, b| a.session_id.cmp(&b.session_id));
+
+    let mut state = UnifiedParseState {
+        generations: checkpoint.parse_generations.into_iter().collect(),
+        fallback_model_by_pid: checkpoint
+            .fallback_model_by_pid
+            .into_iter()
+            .map(|(pid, generation, model)| ((pid, generation), model))
+            .collect(),
+        model_by_pid_and_session: checkpoint
+            .model_by_pid_and_session
+            .into_iter()
+            .map(|(pid, generation, sid, model)| ((pid, generation, sid), model))
+            .collect(),
+        model_by_session: checkpoint.model_by_session.into_iter().collect(),
+        seen: old
+            .iter()
+            .filter_map(|message| message.dedup_key.clone())
+            .collect(),
+        messages: Vec::new(),
+        used_fallback_timestamp: false,
+    };
+    #[cfg(test)]
+    GROK_UNIFIED_PARSED_PATHS
+        .lock()
+        .unwrap()
+        .push(path.to_path_buf());
+    let fallback_timestamp = file_modified_timestamp_ms(path);
+    file.seek(SeekFrom::Start(checkpoint.offset)).ok()?;
+    for line in
+        lossy_lines(BufReader::new(CountedRead(&mut file)).take(complete_len - checkpoint.offset))
+    {
+        state.process_line(&line, evidence, &metadata_by_session, fallback_timestamp);
+    }
+    if state.used_fallback_timestamp {
+        return None;
+    }
+
+    let mut messages = old.to_vec();
+    messages.extend(state.messages.drain(..));
+    let message_hash = messages_hash(messages.iter());
+    match build_checkpoint(
+        &mut file,
+        complete_len,
+        &scan.generations,
+        &scan.complete,
+        &state,
+        messages.len() as u64,
+        message_hash,
+        new_fingerprint_hash,
+        sessions,
+    ) {
+        Some(checkpoint) => write_checkpoint(path, &checkpoint),
+        None => remove_checkpoint(path),
+    }
+    // `state.seen` now holds the complete lines; the tail only adds rows.
+    parse_unterminated_tail(
+        &mut file,
+        complete_len,
+        log_len,
+        &mut state,
+        evidence,
+        &metadata_by_session,
+        fallback_timestamp,
+    )?;
+    messages.append(&mut state.messages);
+    Some(messages)
+}
