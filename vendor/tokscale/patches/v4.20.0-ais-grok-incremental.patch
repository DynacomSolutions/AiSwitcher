+// ---------------------------------------------------------------------------
+// AIS: incremental unified-log parse.
+//
+// Grok appends to `logs/unified.jsonl` all the time, so the log changes on
+// every collector cycle and used to be read three times in full per cycle (the
+// fingerprint's referenced-session scan and the parse's two passes). A
+// checkpoint stored beside the message cache remembers the parse state at the
+// end of the last complete line. A later scan checks that the log still starts
+// with the same bytes, then reads only what was appended. Every doubt (a
+// rotated or truncated log, a changed prefix sample, new subagent evidence, a
+// changed session, a row without a timestamp) falls back to the full parse, so
+// the messages always equal a full read of the complete lines.
+// ---------------------------------------------------------------------------
+
+const CHECKPOINT_VERSION: u32 = 1;
+const CHECKPOINT_WINDOW: u64 = 64 * 1024;
+const CHECKPOINT_DIRNAME: &str = "ais-grok-unified-v1";
+
+/// AIS: bytes read from unified logs (test instrumentation).
+#[cfg(test)]
+pub(crate) static GROK_UNIFIED_BYTES_READ: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+struct CountedRead<R>(R);
+
+impl<R: Read> Read for CountedRead<R> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        let read = self.0.read(buf)?;
+        #[cfg(test)]
+        GROK_UNIFIED_BYTES_READ.fetch_add(read as u64, std::sync::atomic::Ordering::Relaxed);
+        Ok(read)
+    }
+}
+
+type ScopeModels = Vec<(UnifiedChildScope, UnifiedModelEvidence)>;
+
+#[derive(serde::Serialize, serde::Deserialize)]
+struct EvidenceWire {
+    known_scopes: Vec<UnifiedChildScope>,
+    child_models: ScopeModels,
+    terminal_scopes: Vec<UnifiedChildScope>,
+    terminal_models: ScopeModels,
+    child_session_ids: Vec<String>,
+    referenced_session_ids: Vec<String>,
+}
+
+impl From<&UnifiedChildEvidence> for EvidenceWire {
+    fn from(evidence: &UnifiedChildEvidence) -> Self {
+        fn models(map: &HashMap<UnifiedChildScope, UnifiedModelEvidence>) -> ScopeModels {
+            map.iter().map(|(k, v)| (k.clone(), v.clone())).collect()
+        }
+        Self {
+            known_scopes: evidence.known_scopes.iter().cloned().collect(),
+            child_models: models(&evidence.child_models),
+            terminal_scopes: evidence.terminal_scopes.iter().cloned().collect(),
+            terminal_models: models(&evidence.terminal_models),
+            child_session_ids: evidence.child_session_ids.iter().cloned().collect(),
+            referenced_session_ids: evidence.referenced_session_ids.iter().cloned().collect(),
+        }
+    }
+}
+
+impl From<EvidenceWire> for UnifiedChildEvidence {
+    fn from(wire: EvidenceWire) -> Self {
+        Self {
+            known_scopes: wire.known_scopes.into_iter().collect(),
+            child_models: wire.child_models.into_iter().collect(),
+            terminal_scopes: wire.terminal_scopes.into_iter().collect(),
+            terminal_models: wire.terminal_models.into_iter().collect(),
+            child_session_ids: wire.child_session_ids.into_iter().collect(),
+            referenced_session_ids: wire.referenced_session_ids.into_iter().collect(),
+        }
+    }
+}
