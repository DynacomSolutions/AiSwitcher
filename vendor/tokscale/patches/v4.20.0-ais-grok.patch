+            );
+
+            // Unchanged home: the unified log is neither parsed nor are any
+            // session metadata files read.
+            reset();
+            assert_eq!(scan(home.path()), expected, "{label}: unchanged");
+            assert!(!parsed(), "{label}: unchanged log must stay cached");
+            assert!(metadata_reads().is_empty(), "{label}: unchanged reads");
