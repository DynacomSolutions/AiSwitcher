+            let env = redirect_cache_home(cache_home.path());
+
+            // The log grows and now names s2: only the referenced sessions are
+            // read, never s4.
+            tick();
+            ais_incremental_append(&unified, &ais_grok_inference("s2", 14, 4, 400));
+            reset();
+            let after_append = scan(home.path());
+            assert!(parsed(), "{label}: grown log must re-parse");
+            assert_eq!(
+                metadata_reads(),
+                vec!["s1", "s2", "s3"],
+                "{label}: append reads"
+            );
+            drop(env);
+            assert_eq!(after_append, cold(home.path()), "{label}: append");
+            assert!(after_append
+                .iter()
+                .any(|row| row.2 == "s2" && row.1 == "grok-5"));
+            let env = redirect_cache_home(cache_home.path());
+
+            // A referenced session's metadata changes under an unchanged log.
+            tick();
+            std::fs::write(
+                ws_b.join("s3/summary.json"),
+                r#"{"current_model_id":"grok-code","updated_at":"2026-11-03T00:00:00Z"}"#,
+            )
+            .unwrap();
+            reset();
+            let after_referenced = scan(home.path());
+            assert!(
+                parsed(),
+                "{label}: referenced metadata change must re-parse"
+            );
+            drop(env);
+            assert_eq!(after_referenced, cold(home.path()), "{label}: referenced");
+            assert!(after_referenced
+                .iter()
+                .any(|row| row.2 == "s3" && row.1 == "grok-code"));
+            let env = redirect_cache_home(cache_home.path());
+
+            // A session the log already names appears on disk later.
+            tick();
+            ais_grok_session(&ws_b.join("s-new"), "grok-4", None);
+            reset();
+            let after_new_dir = scan(home.path());
+            assert!(parsed(), "{label}: a new referenced session must re-parse");
+            drop(env);
+            assert_eq!(after_new_dir, cold(home.path()), "{label}: new session dir");
+            assert!(after_new_dir
+                .iter()
