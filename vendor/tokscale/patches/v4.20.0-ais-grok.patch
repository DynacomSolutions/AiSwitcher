+                ))
+            };
+            let cold = |home: &std::path::Path| {
+                let fresh_cache = tempfile::TempDir::new().unwrap();
+                let _env = redirect_cache_home(fresh_cache.path());
+                scan(home)
+            };
+            let reset = || {
+                sessions::grok::GROK_UNIFIED_PARSED_PATHS
+                    .lock()
+                    .unwrap()
+                    .clear();
+                sessions::grok::GROK_UNIFIED_METADATA_READS
+                    .lock()
+                    .unwrap()
+                    .clear();
+            };
+            let parsed = || {
+                !sessions::grok::GROK_UNIFIED_PARSED_PATHS
+                    .lock()
+                    .unwrap()
+                    .is_empty()
+            };
+            let metadata_reads = || {
