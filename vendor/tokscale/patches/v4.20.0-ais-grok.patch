+            // Directory and file mtimes must move between steps.
+            let tick = || std::thread::sleep(std::time::Duration::from_millis(30));
+            let label = if stat_only { "stat-only" } else { "sampled" };
+
+            let expected = cold(home.path());
+            assert!(!expected.is_empty());
+            let env = redirect_cache_home(cache_home.path());
+            reset();
+            assert_eq!(scan(home.path()), expected, "{label}: first warm scan");
+            assert_eq!(
