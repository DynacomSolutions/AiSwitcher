+    /// referenced sessions are read from the prefix that stat bounds, and the
+    /// stored log signature is that first stat: if the log grew meanwhile the
+    /// entry is never fresh, and the next scan rebuilds it. Directories store
+    /// the signature they had before they were listed, so one that changed
+    /// after its listing never matches either.
+    fn from_grok_unified_path(path: &Path, mode: ContentHashMode) -> Option<Self> {
+        let (log_size, log_modified_ns) = metadata_signature(path).ok()?;
+        let related_paths = crate::sessions::grok::grok_unified_related_paths(path, log_size)?;
+        #[cfg(test)]
