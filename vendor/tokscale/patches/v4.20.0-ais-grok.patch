+                Some(signature) => Some(RelatedFileFingerprint {
+                    suffix,
+                    path: CachedPath::from_path(&related_path),
+                    exists: signature.is_some(),
+                    size: signature.map_or(0, |(size, _)| size),
+                    modified_ns: signature.map_or(0, |(_, modified_ns)| modified_ns),
+                    sample_hashes: Vec::new(),
+                    content_hash: [0; 32],
+                }),
+                None => RelatedFileFingerprint::from_path(suffix, &related_path, mode),
+            })
+            .collect::<Option<_>>()?;
+        related_files.sort_by(|left, right| left.suffix.cmp(&right.suffix));
+
+        Some(Self {
+            size: log_size,
+            modified_ns: log_modified_ns,
+            sample_hashes,
+            content_hash,
+            related_files,
