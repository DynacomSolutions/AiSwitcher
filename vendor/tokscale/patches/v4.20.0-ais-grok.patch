+    /// A unified log only takes metadata from the sessions it names. A warm
+    /// scan of an unchanged Grok home reads nothing, a changed log reads only
+    /// the sessions it references, never the rest of the tree, and every warm
+    /// result equals a cold scan.
+    #[test]
+    #[serial_test::serial]
+    fn ais_grok_unified_warm_scan_reads_only_referenced_sessions_and_matches_cold() {
+        for stat_only in [true, false] {
+            let cache_home = tempfile::TempDir::new().unwrap();
+            let home = tempfile::TempDir::new().unwrap();
+            let mut stat_env =
+                crate::paths::test_env::EnvGuard::capture(&["TOKSCALE_AIS_STAT_ONLY_CACHE"]);
+            if stat_only {
+                stat_env.set("TOKSCALE_AIS_STAT_ONLY_CACHE", "1");
+            } else {
+                stat_env.remove("TOKSCALE_AIS_STAT_ONLY_CACHE");
+            }
+            let sessions = home.path().join(".grok/sessions");
+            let ws_a = sessions.join("%2Ftmp%2Fa");
+            let ws_b = sessions.join("%2Ftmp%2Fb");
+            // Referenced: s1 (legacy updates too) and s3 (no updates.jsonl).
+            ais_grok_session(&ws_a.join("s1"), "grok-code", Some(500));
+            ais_grok_session(&ws_b.join("s3"), "grok-4", None);
+            // Unreferenced: s2 until the log names it, s4 never.
+            ais_grok_session(&ws_a.join("s2"), "grok-3", Some(900));
+            ais_grok_session(&ws_b.join("s4"), "grok-3", Some(700));
+            let logs = home.path().join(".grok/logs");
+            std::fs::create_dir_all(&logs).unwrap();
+            let unified = logs.join("unified.jsonl");
+            std::fs::write(
+                &unified,
+                format!(
+                    "{}{}{}",
+                    ais_grok_inference("s1", 11, 1, 100),
+                    ais_grok_inference("s3", 12, 2, 200),
+                    ais_grok_inference("s-new", 13, 3, 300)
+                ),
+            )
+            .unwrap();
+
+            let mut litellm = HashMap::new();
+            for model in ["grok-code", "grok-4", "grok-3", "grok-5"] {
+                litellm.insert(
+                    model.to_string(),
+                    pricing::ModelPricing {
+                        input_cost_per_token: Some(0.001),
+                        output_cost_per_token: Some(0.002),
+                        ..Default::default()
+                    },
+                );
+            }
+            let pricing = pricing::PricingService::new(litellm, HashMap::new());
+            let scan = |home: &std::path::Path| {
+                ais_grok_rows(&parse_all_messages_with_pricing_with_env_strategy(
+                    home.to_str().unwrap(),
+                    &["grok".to_string()],
+                    Some(&pricing),
+                    false,
+                    &scanner::ScannerSettings::default(),
+                ))
+            };
+            let cold = |home: &std::path::Path| {
+                let fresh_cache = tempfile::TempDir::new().unwrap();
+                let _env = redirect_cache_home(fresh_cache.path());
+                scan(home)
+            };
+            let reset = || {
+                sessions::grok::GROK_UNIFIED_PARSED_PATHS
+                    .lock()
+                    .unwrap()
+                    .clear();
+                sessions::grok::GROK_UNIFIED_METADATA_READS
+                    .lock()
+                    .unwrap()
+                    .clear();
+            };
+            let parsed = || {
+                !sessions::grok::GROK_UNIFIED_PARSED_PATHS
+                    .lock()
+                    .unwrap()
+                    .is_empty()
+            };
+            let metadata_reads = || {
+                let mut names: Vec<String> = sessions::grok::GROK_UNIFIED_METADATA_READS
+                    .lock()
+                    .unwrap()
+                    .iter()
+                    .map(|dir| dir.file_name().unwrap().to_string_lossy().into_owned())
+                    .collect();
+                names.sort();
+                names.dedup();
+                names
+            };
+            // Directory and file mtimes must move between steps.
+            let tick = || std::thread::sleep(std::time::Duration::from_millis(30));
+            let label = if stat_only { "stat-only" } else { "sampled" };
+
+            let expected = cold(home.path());
+            assert!(!expected.is_empty());
+            let env = redirect_cache_home(cache_home.path());
+            reset();
+            assert_eq!(scan(home.path()), expected, "{label}: first warm scan");
+            assert_eq!(
+                metadata_reads(),
+                vec!["s1", "s3"],
+                "{label}: first scan reads"
+            );
+
+            // Unchanged home: the unified log is neither parsed nor are any
+            // session metadata files read.
+            reset();
+            assert_eq!(scan(home.path()), expected, "{label}: unchanged");
+            assert!(!parsed(), "{label}: unchanged log must stay cached");
+            assert!(metadata_reads().is_empty(), "{label}: unchanged reads");
+
+            // An unreferenced session changes and gains a file: the unified
+            // log stays cached and the totals still equal a cold scan.
+            tick();
+            std::fs::write(
+                ws_a.join("s2/summary.json"),
+                r#"{"current_model_id":"grok-5","updated_at":"2026-11-02T00:00:00Z"}"#,
+            )
+            .unwrap();
+            std::fs::write(ws_b.join("s4/rewind_points.jsonl"), "{}\n").unwrap();
+            reset();
+            let after_unrelated = scan(home.path());
+            assert!(!parsed(), "{label}: unreferenced change must not re-parse");
+            drop(env);
+            assert_eq!(after_unrelated, cold(home.path()), "{label}: unrelated");
+            let env = redirect_cache_home(cache_home.path());
+
+            // The log grows and now names s2: only the referenced sessions are
+            // read, never s4.
+            tick();
+            ais_incremental_append(&unified, &ais_grok_inference("s2", 14, 4, 400));
+            reset();
+            let after_append = scan(home.path());
+            assert!(parsed(), "{label}: grown log must re-parse");
+            assert_eq!(
+                metadata_reads(),
+                vec!["s1", "s2", "s3"],
+                "{label}: append reads"
+            );
+            drop(env);
+            assert_eq!(after_append, cold(home.path()), "{label}: append");
+            assert!(after_append
+                .iter()
+                .any(|row| row.2 == "s2" && row.1 == "grok-5"));
+            let env = redirect_cache_home(cache_home.path());
+
+            // A referenced session's metadata changes under an unchanged log.
+            tick();
+            std::fs::write(
+                ws_b.join("s3/summary.json"),
+                r#"{"current_model_id":"grok-code","updated_at":"2026-11-03T00:00:00Z"}"#,
+            )
+            .unwrap();
+            reset();
+            let after_referenced = scan(home.path());
+            assert!(
+                parsed(),
+                "{label}: referenced metadata change must re-parse"
+            );
+            drop(env);
+            assert_eq!(after_referenced, cold(home.path()), "{label}: referenced");
+            assert!(after_referenced
+                .iter()
+                .any(|row| row.2 == "s3" && row.1 == "grok-code"));
+            let env = redirect_cache_home(cache_home.path());
+
+            // A session the log already names appears on disk later.
+            tick();
+            ais_grok_session(&ws_b.join("s-new"), "grok-4", None);
+            reset();
+            let after_new_dir = scan(home.path());
+            assert!(parsed(), "{label}: a new referenced session must re-parse");
+            drop(env);
+            assert_eq!(after_new_dir, cold(home.path()), "{label}: new session dir");
+            assert!(after_new_dir
+                .iter()
+                .any(|row| row.2 == "s-new" && row.1 == "grok-4"));
+            assert!(
+                !sessions::grok::GROK_UNIFIED_METADATA_READS
+                    .lock()
+                    .unwrap()
+                    .iter()
+                    .any(|dir| dir.ends_with("s4")),
+                "{label}: an unreferenced session is never read"
+            );
+            drop(stat_env);
+        }
+    }
