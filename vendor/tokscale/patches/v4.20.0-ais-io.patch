+/// What the exporter writes: the envelope above plus the digest of its
+/// `messages` array, borrowed rather than cloned.
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+struct AisBatchEnvelopeOut<'a> {
+    schema_version: u32,
+    partition_id: &'a str,
+    generated_at: &'a str,
+    complete: bool,
+    messages_sha256: &'a str,
+    messages: &'a [UnifiedMessage],
+}
+
+/// Written instead of a batch when the messages are byte-identical to the
+/// previous batch. It has no `complete` or `messages`, so a reader that
+/// expects a batch rejects it.
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+struct AisUnchangedEnvelope<'a> {
+    schema_version: u32,
+    partition_id: &'a str,
+    generated_at: &'a str,
+    unchanged: bool,
+    messages_sha256: &'a str,
+}
+
+struct Sha256Writer(sha2::Sha256);
+
+impl std::io::Write for Sha256Writer {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        sha2::Digest::update(&mut self.0, bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        Ok(())
+    }
+}
+
+/// SHA-256 of the `messages` array exactly as the batch serializes it.
+fn ais_messages_sha256(messages: &[UnifiedMessage]) -> Result<String, String> {
+    let mut writer = Sha256Writer(sha2::Sha256::default());
+    serde_json::to_writer(&mut writer, messages).map_err(|e| format!("AIS batch digest: {e}"))?;
+    let digest = sha2::Digest::finalize(writer.0);
+    Ok(digest.iter().map(|byte| format!("{byte:02x}")).collect())
+}
