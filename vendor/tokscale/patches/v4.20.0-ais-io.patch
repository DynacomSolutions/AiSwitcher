+#[test]
+fn ais_native_export_reports_unchanged_messages_instead_of_rewriting_the_batch() {
+    let tmp = create_codex_fixture_dir();
+    let partition_id = "b".repeat(64);
+    let run = |export_path: &std::path::Path, previous: Option<&str>| {
+        let mut command = cmd_with_home(tmp.path());
+        command
+            .env("TOKSCALE_AIS_EXPORT_PATH", export_path)
+            .env("TOKSCALE_AIS_PARTITION_ID", &partition_id)
+            .env(
+                "TOKSCALE_AIS_SOURCE_CONFIG_DIR",
+                tmp.path().join("original-tokscale-config"),
+            )
+            .args(["--json", "--client", "codex", "--no-spinner"]);
+        if let Some(previous) = previous {
+            command.env("TOKSCALE_AIS_PREVIOUS_MESSAGES_SHA256", previous);
+        }
+        let output = command.output().unwrap();
+        assert!(
+            output.status.success(),
+            "stderr: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        let report: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+        let batch: serde_json::Value =
+            serde_json::from_slice(&fs::read(export_path).unwrap()).unwrap();
+        (report, batch)
+    };
+
+    let (first_report, first) = run(&tmp.path().join("first.json"), None);
+    let digest = first["messagesSha256"].as_str().unwrap().to_string();
+    assert_eq!(digest.len(), 64);
+    use sha2::Digest;
+    // The digest covers the `messages` array exactly as written: the last field.
+    let raw = fs::read(tmp.path().join("first.json")).unwrap();
+    let key = b"\"messages\":";
+    let start = raw.windows(key.len()).rposition(|window| window == key).unwrap() + key.len();
+    let messages = &raw[start..raw.len() - 1];
+    assert_eq!(
+        digest,
+        sha2::Sha256::digest(messages)
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect::<String>()
+    );
+
+    let (mut second_report, second) = run(&tmp.path().join("second.json"), Some(&digest));
+    let mut first_report = first_report;
+    for report in [&mut first_report, &mut second_report] {
+        report.as_object_mut().unwrap().remove("processingTimeMs");
+    }
+    assert_eq!(second["unchanged"], true);
+    assert_eq!(second["messagesSha256"], digest.as_str());
+    assert_eq!(second["partitionId"], partition_id);
+    assert!(second.get("messages").is_none() && second.get("complete").is_none());
+    assert_eq!(second_report, first_report, "the report is still printed in full");
+
+    let (_, third) = run(&tmp.path().join("third.json"), Some(&"0".repeat(64)));
+    assert_eq!(third["complete"], true);
+    assert_eq!(third["messages"], first["messages"]);
+}
