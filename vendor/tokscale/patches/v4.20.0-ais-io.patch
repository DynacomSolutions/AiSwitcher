 const CLAUDE_READ_BUFFER_BYTES: usize = 64 * 1024;
 
+const SAMPLED_PREFIX_DOMAIN: &[u8] = b"tokscale-ais-claude-sampled-prefix-v1\0";
+const SAMPLED_PREFIX_EDGE_BYTES: u64 = 64 * 1024;
+const SAMPLED_PREFIX_WINDOW_BYTES: u64 = 4 * 1024;
+const SAMPLED_PREFIX_WINDOWS: u64 = 32;
+
+/// AIS: the digest a checkpoint stores for the bytes before `len`.
+///
+/// It covers the first and the last 64 KiB before `len` and 32 evenly spaced
+/// 4 KiB windows between them (every byte when `len` is at most 256 KiB),
+/// plus `len` itself: at most 256 KiB read, however large the transcript.
+/// Upstream hashed the whole prefix, so each resume of a live multi-GB
+/// session re-read all of it.
+///
+/// Trade-off: a rewrite that changes only bytes outside every window, keeps
+/// the file at least `len` long and keeps its cache fingerprint moving is
+/// resumed instead of re-parsed. Claude Code appends to a session transcript
+/// and never edits earlier lines in place; a rewrite through a new file, a
+/// truncation, or any edit touching a window still forces the full parse.
+/// The domain prefix keeps an upstream full-prefix digest from ever matching,
+/// so a checkpoint from before this change is re-parsed once.
+fn sampled_prefix_digest(file: &std::fs::File, len: u64) -> Option<[u8; 32]> {
+    let mut hasher = Sha256::new();
+    hasher.update(SAMPLED_PREFIX_DOMAIN);
+    hasher.update(len.to_le_bytes());
+    let mut windows: Vec<(u64, u64)> = Vec::new();
+    if len <= 2 * SAMPLED_PREFIX_EDGE_BYTES + SAMPLED_PREFIX_WINDOWS * SAMPLED_PREFIX_WINDOW_BYTES {
+        windows.push((0, len));
+    } else {
+        windows.push((0, SAMPLED_PREFIX_EDGE_BYTES));
+        let middle_start = SAMPLED_PREFIX_EDGE_BYTES;
+        let middle_len = len - 2 * SAMPLED_PREFIX_EDGE_BYTES;
+        let stride = middle_len / SAMPLED_PREFIX_WINDOWS;
+        for index in 0..SAMPLED_PREFIX_WINDOWS {
+            windows.push((middle_start + index * stride, SAMPLED_PREFIX_WINDOW_BYTES.min(stride)));
+        }
+        windows.push((len - SAMPLED_PREFIX_EDGE_BYTES, SAMPLED_PREFIX_EDGE_BYTES));
+    }
+    let mut buffer = vec![0_u8; CLAUDE_READ_BUFFER_BYTES];
+    for (start, length) in windows {
+        hasher.update(start.to_le_bytes());
+        hasher.update(length.to_le_bytes());
+        let mut done = 0_u64;
+        while done < length {
+            let take = (length - done).min(buffer.len() as u64) as usize;
+            read_exact_at(file, &mut buffer[..take], start + done)?;
+            hasher.update(&buffer[..take]);
+            done += take as u64;
+        }
+    }
+    Some(hasher.finalize().into())
+}
+
+#[cfg(unix)]
+fn read_exact_at(file: &std::fs::File, buffer: &mut [u8], offset: u64) -> Option<()> {
+    std::os::unix::fs::FileExt::read_exact_at(file, buffer, offset).ok()
+}
+
+#[cfg(windows)]
+fn read_exact_at(file: &std::fs::File, buffer: &mut [u8], offset: u64) -> Option<()> {
+    let mut done = 0;
+    while done < buffer.len() {
+        let read = std::os::windows::fs::FileExt::seek_read(file, &mut buffer[done..], offset + done as u64).ok()?;
+        if read == 0 {
+            return None;
+        }
+        done += read;
+    }
+    Some(())
+}
