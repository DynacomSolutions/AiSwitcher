+    #[test]
+    #[serial_test::serial]
+    fn ais_cache_scope_interrupted_seed_prefers_newer_shared_entries_and_retained_history() {
+        let dir = TempDir::new().unwrap();
+        let _env = sandbox_cache_env(dir.path());
+        let identity = CacheIdentity::for_client(ClientId::Claude);
+        let root = dir.path().join("identity-a").join("projects");
+        std::fs::create_dir_all(&root).unwrap();
+        let live = root.join("live.jsonl");
+        let gone = root.join("gone.jsonl");
+        std::fs::write(&live, b"{}\n").unwrap();
+        std::fs::write(&gone, b"{}\n").unwrap();
+
+        // The interrupted seed wrote an older copy of `live` and a copy of
+        // `gone` without retained history.
+        let stale_live = test_entry(identity, &live, "live-stale");
+        let mut plain_gone = test_entry(identity, &gone, "gone-plain");
+        // Provenance says this copy retains nothing, so once `gone` is
+        // deleted the scoped pass drops it as missing.
+        plain_gone.fallback_timestamp_indices = vec![CLAUDE_RETENTION_PROVENANCE_MARKER];
+        ais_scope_set(Some("0e"));
+        let scoped_root = scoped_shard_dir("0e").unwrap();
+        ensure_cache_dir(&scoped_root.join(identity.namespace)).unwrap();
+        for entry in [stale_live, plain_gone] {
+            let shard = CacheKey::from_entry(&entry).shard();
+            write_shard_with_limit(
+                &shard_path(&scoped_root, &shard),
+                identity,
+                &[entry],
+                MAX_CACHE_SHARD_BYTES,
+            )
+            .unwrap();
+        }
+
+        // Later the shared cache saw `live` grow and kept `gone`'s history.
+        std::thread::sleep(std::time::Duration::from_millis(20));
+        std::fs::write(&live, b"{}\n{}\n").unwrap();
+        let mut retained = test_entry(identity, &gone, "gone-retained");
+        retained.fallback_timestamp_indices = vec![0];
+        ais_scope_set(None);
+        let mut shared = SourceMessageCache::load();
+        shared.insert(test_entry(identity, &live, "live-newer"));
+        shared.insert(retained);
+        shared.save_if_dirty();
+        std::fs::remove_file(&gone).unwrap();
+
+        ais_scope_set(Some("0e"));
+        let mut scoped = SourceMessageCache::load();
+        assert_eq!(
+            scoped.take(identity, &live).unwrap().messages[0].session_id,
+            "live-newer"
+        );
+        let history = scoped.missing_claude_history(&[root.clone()]);
+        assert_eq!(history.len(), 1);
+        assert_eq!(history[0].messages[0].session_id, "gone-retained");
+        scoped.save_if_dirty();
+
+        let warm = SourceMessageCache::load();
+        assert_eq!(
+            warm.get(identity, &live).unwrap().messages[0].session_id,
+            "live-newer"
+        );
+        assert_eq!(warm.missing_claude_history(&[root]).len(), 1);
+        ais_scope_set(None);
+    }
