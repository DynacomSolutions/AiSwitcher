+/// AIS: per-partition cache scopes. The usage collector exports one identity
+/// at a time, but every export used to deserialize the whole namespace (every
+/// identity's Claude or Codex history) and rewrite every shard one of its
+/// dirty entries hashed into. With `TOKSCALE_AIS_CACHE_SCOPE=<lowercase hex>`
+/// the shards live under `source-message-cache-v2-ais-scope/<scope>/`, so a
+/// scan reads and writes only its own partition's entries.
+///
+/// A namespace is seeded once from the shared shards: that first scoped scan
+/// loads the shared namespace as before and records every entry it looks up.
+/// Its save writes exactly those entries (plus its own changes) to the scoped
+/// shards and then publishes `.ais-scope-seeded`. Entries the scan never asked
+/// for belong to other partitions. Retained Claude history of a deleted
+/// transcript is looked up through `missing_claude_history`, so it is carried
+/// over. Until the marker exists the shared shards stay authoritative, and a
+/// scoped shard left by an interrupted seed wins over its shared copy.
+const AIS_SCOPED_CACHE_DIRNAME: &str = "source-message-cache-v2-ais-scope";
+const AIS_SCOPE_SEEDED_MARKER: &str = ".ais-scope-seeded";
+
+fn ais_cache_scope() -> Option<String> {
+    let value = std::env::var("TOKSCALE_AIS_CACHE_SCOPE").ok()?;
+    (!value.is_empty()
+        && value.len() <= 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)))
+    .then_some(value)
+}
+
+fn scoped_shard_dir(scope: &str) -> Option<PathBuf> {
+    Some(cache_dir()?.join(AIS_SCOPED_CACHE_DIRNAME).join(scope))
+}
+
+/// AIS: reconcile a scoped entry (left by an interrupted seed) with the
+/// shared entry for the same source. The copy with the newer source
+/// fingerprint wins, and it absorbs the other's retained history, as the save
+/// merge does for a concurrent writer.
+/// For a deleted source only a copy that retains history still counts, so
+/// that copy wins regardless of fingerprints.
+fn prefer_seed_entry(scoped: CachedSourceEntry, shared: CachedSourceEntry) -> CachedSourceEntry {
+    let source_gone = !scoped.path.to_path_buf().exists();
+    let shared_is_newer = if source_gone
+        && scoped.holds_retained_history() != shared.holds_retained_history()
+    {
+        shared.holds_retained_history()
+    } else {
+        (shared.fingerprint.modified_ns, shared.fingerprint.size)
+            > (scoped.fingerprint.modified_ns, scoped.fingerprint.size)
+    };
+    let (mut keep, other) = if shared_is_newer {
+        (shared, scoped)
+    } else {
+        (scoped, shared)
+    };
+    keep.absorb_retained_history(&other);
+    keep
+}
+
+fn write_scope_seeded_marker(namespace_dir: &Path) -> std::io::Result<()> {
+    ensure_cache_dir(namespace_dir)?;
+    let marker = namespace_dir.join(AIS_SCOPE_SEEDED_MARKER);
+    let temp = namespace_dir.join(format!(
+        "{AIS_SCOPE_SEEDED_MARKER}.{}.tmp",
+        std::process::id()
+    ));
+    let file = File::create(&temp)?;
+    file.sync_all()?;
+    drop(file);
+    fs::rename(&temp, &marker)?;
+    File::open(namespace_dir)?.sync_all()
+}
