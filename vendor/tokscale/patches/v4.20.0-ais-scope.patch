+    #[test]
+    fn ais_codex_resume_of_a_large_rollout_reads_only_sampled_windows() {
+        let mut original = Vec::new();
+        while original.len() < 4 * 1024 * 1024 {
+            original.extend_from_slice(b"{\"type\":\"event_msg\",\"payload\":{}}\n");
+        }
+        let file = write_temp_file(&original);
+        FULL_HASH_CALLS.with(|calls| calls.set(0));
+        let fingerprint = SourceFingerprint::from_codex_path(file.path()).unwrap();
+        let incremental_cache = build_codex_incremental_cache_with_prefix_hash(
+            file.path(),
+            fingerprint.size,
+            CodexParseState::default(),
+            fingerprint.content_hash,
+        )
+        .unwrap();
+        // The fingerprint digest doubles as the prefix digest at the file size.
+        assert_eq!(
+            incremental_cache.prefix_hash,
+            codex_prefix_digest(file.path(), fingerprint.size).unwrap()
+        );
+
+        let mut grown = original.clone();
+        grown.extend_from_slice(b"appended\n");
+        std::fs::write(file.path(), &grown).unwrap();
+        assert!(codex_prefix_matches(file.path(), &incremental_cache));
+        let FingerprintStatus::Changed(changed) =
+            SourceFingerprint::check_codex_path(file.path(), Some(&fingerprint)).unwrap()
+        else {
+            panic!("a grown rollout is a changed fingerprint");
+        };
+        assert_ne!(changed.content_hash, fingerprint.content_hash);
+        assert_eq!(FULL_HASH_CALLS.with(|calls| calls.get()), 0, "no whole-file hash");
+
+        // A truncation or an edit inside a sampled window is never resumed.
+        let mut edited = grown.clone();
+        edited[10] = b'X';
+        std::fs::write(file.path(), &edited).unwrap();
+        assert!(!codex_prefix_matches(file.path(), &incremental_cache));
+        std::fs::write(file.path(), &original[..original.len() - 100]).unwrap();
+        assert!(!codex_prefix_matches(file.path(), &incremental_cache));
+    }
