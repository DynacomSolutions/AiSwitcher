+    fn ais_scope_seed_once(root: &Path, live: &Path) -> usize {
+        let identity = CacheIdentity::for_client(ClientId::Claude);
+        let mut scoped = SourceMessageCache::load();
+        let _ = scoped.take(identity, live);
+        let history = scoped.missing_claude_history(&[root.to_path_buf()]).len();
+        scoped.save_if_dirty();
+        history
