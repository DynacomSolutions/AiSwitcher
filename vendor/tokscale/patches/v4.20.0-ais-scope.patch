+/// AIS: the digest a Codex incremental entry stores for the bytes before
+/// `len`, and the `content_hash` of a plain rollout's fingerprint. It is the
+/// Claude checkpoint's sampled digest (`claudecode::sampled_prefix_digest`)
+/// under its own domain: at most 256 KiB read, however large the rollout.
+/// Upstream hashed every byte of the prefix on each resume and again for each
+/// changed fingerprint, so a growing multi-hundred-MB rollout was read whole
+/// several times per scan.
+///
+/// Trade-off (as for Claude): an in-place edit that touches no sampled window,
+/// keeps the file at least `len` long and changes its size or mtime resumes
+/// instead of re-parsing. Codex appends to a rollout; a truncation, a rewrite
+/// through a new file or an edit inside a window still forces the full parse.
+/// The domain keeps an upstream full-prefix hash from matching, so an entry
+/// written before this change is re-parsed once.
+fn codex_prefix_digest(path: &Path, len: u64) -> Option<[u8; 32]> {
+    let file = File::open(path).ok()?;
+    crate::sessions::claudecode::ais_sampled_prefix_digest(CODEX_SAMPLED_PREFIX_DOMAIN, &file, len)
