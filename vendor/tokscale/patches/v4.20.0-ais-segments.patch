+/// With `TOKSCALE_AIS_SEGMENT_DIR`, the export path gets a small manifest and
+/// the messages go to content-addressed segments. Only segments AIS lists as
+/// verified are left alone; all others are (re)written, so a damaged file is
+/// never adopted. The messages and their digest equal the single-file batch.
+#[test]
+fn ais_native_export_writes_segments_and_rewrites_only_unlisted_ones() {
+    use sha2::Digest;
+    let tmp = create_codex_fixture_dir();
+    let partition_id = "d".repeat(64);
+    let segments_dir = tmp.path().join("segments");
+    let run = |export_path: &std::path::Path, segmented: bool, reusable: Option<&str>| {
+        let mut command = cmd_with_home(tmp.path());
+        command
+            .env("TOKSCALE_AIS_EXPORT_PATH", export_path)
+            .env("TOKSCALE_AIS_PARTITION_ID", &partition_id)
+            .env(
+                "TOKSCALE_AIS_SOURCE_CONFIG_DIR",
+                tmp.path().join("original-tokscale-config"),
+            )
+            .args(["--json", "--client", "codex", "--no-spinner"]);
+        if segmented {
+            command.env("TOKSCALE_AIS_SEGMENT_DIR", &segments_dir);
+        }
+        if let Some(list) = reusable {
+            let file = tmp.path().join("reusable.txt");
+            fs::write(&file, list).unwrap();
+            command.env("TOKSCALE_AIS_REUSABLE_SEGMENTS_FILE", file);
+        }
+        let output = command.output().unwrap();
+        assert!(
+            output.status.success(),
+            "stderr: {}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        serde_json::from_slice::<serde_json::Value>(&fs::read(export_path).unwrap()).unwrap()
+    };
+
+    let single = run(&tmp.path().join("single.json"), false, None);
+    let manifest = run(&tmp.path().join("segmented.json"), true, None);
+    assert_eq!(manifest["schemaVersion"], 2);
+    assert_eq!(manifest["format"], "ais-segmented-v1");
+    assert_eq!(manifest["complete"], true);
+    assert!(manifest.get("messages").is_none());
+    assert_eq!(manifest["messagesSha256"], single["messagesSha256"]);
+    assert!(manifest["hourly"]
+        .as_array()
+        .is_some_and(|hours| !hours.is_empty()));
+    let segments = manifest["segments"].as_array().unwrap();
+    assert!(!segments.is_empty());
+    let mut joined = Vec::new();
+    for segment in segments {
+        let sha = segment["sha256"].as_str().unwrap();
+        let bytes = fs::read(segments_dir.join(format!("{sha}.json"))).unwrap();
+        assert_eq!(bytes.len() as u64, segment["bytes"].as_u64().unwrap());
+        let digest: String = sha2::Sha256::digest(&bytes)
+            .iter()
+            .map(|byte| format!("{byte:02x}"))
+            .collect();
+        assert_eq!(digest, sha);
+        joined.extend(serde_json::from_slice::<Vec<serde_json::Value>>(&bytes).unwrap());
+    }
+    assert_eq!(serde_json::Value::Array(joined), single["messages"]);
+    #[cfg(unix)]
+    for segment in segments {
+        use std::os::unix::fs::PermissionsExt;
+        let path = segments_dir.join(format!("{}.json", segment["sha256"].as_str().unwrap()));
+        assert_eq!(fs::metadata(path).unwrap().permissions().mode() & 0o777, 0o600);
+    }
+    // The manifest's hourly rollup is Tokscale's own `hourly` report.
+    let output = cmd_with_home(tmp.path())
+        .args(["hourly", "--client", "codex", "--json", "--no-spinner"])
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    let hourly: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+    let report_hours = hourly["entries"].as_array().unwrap();
+    let manifest_hours = manifest["hourly"].as_array().unwrap();
+    assert_eq!(report_hours.len(), manifest_hours.len());
+    for (report, exported) in report_hours.iter().zip(manifest_hours) {
+        for field in ["hour", "input", "output", "cacheRead", "cacheWrite", "messageCount", "cost"] {
+            assert_eq!(report[field], exported[field], "{field}");
+        }
+    }
+    let first = segments[0]["sha256"].as_str().unwrap();
+    let first_path = segments_dir.join(format!("{first}.json"));
+
+    // Listed as verified: left alone, even when damaged on disk.
+    fs::write(&first_path, b"damaged").unwrap();
+    run(
+        &tmp.path().join("again.json"),
+        true,
+        Some(&format!("{first}\n")),
+    );
+    assert_eq!(fs::read(&first_path).unwrap(), b"damaged");
+    // Not listed: rewritten from the scan.
+    let again = run(&tmp.path().join("rebuilt.json"), true, Some(""));
+    assert_eq!(again["segments"], manifest["segments"]);
+    let bytes = fs::read(&first_path).unwrap();
+    assert_eq!(bytes.len() as u64, segments[0]["bytes"].as_u64().unwrap());
+}
