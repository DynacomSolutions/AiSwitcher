+    /// Joining the segments' elements gives the single-file `messages` bytes,
+    /// so `messagesSha256` is the same for both formats; and messages added in
+    /// the middle (one transcript grew) change only the segments around them.
+    #[test]
+    fn ais_segmented_batch_matches_single_file_digest_and_localizes_changes() {
+        use sha2::Digest;
+        let messages = ais_segmented_test_messages(60_000, "m");
+        let segments = ais_segment_list(&messages);
+        assert!(segments.len() >= 3, "{} segments", segments.len());
+        let mut joined = vec![b'['];
+        for (index, (_, bytes)) in segments.iter().enumerate() {
+            if index > 0 {
+                joined.push(b',');
+            }
+            joined.extend_from_slice(&bytes[1..bytes.len() - 1]);
+        }
+        joined.push(b']');
+        assert_eq!(joined, serde_json::to_vec(&messages).unwrap());
+        assert_eq!(
+            super::ais_hex(&sha2::Sha256::digest(&joined)),
+            super::ais_messages_sha256(&messages).unwrap()
+        );
+        assert_eq!(segments, ais_segment_list(&messages), "deterministic");
+
+        let mut grown = messages.clone();
+        let middle = grown.len() / 2;
+        grown.splice(middle..middle, ais_segmented_test_messages(200, "new"));
+        let before: HashSet<String> = segments.iter().map(|(sha, _)| sha.clone()).collect();
+        let changed: Vec<_> = ais_segment_list(&grown)
+            .into_iter()
+            .filter(|(sha, _)| !before.contains(sha))
+            .collect();
+        assert!(
+            !changed.is_empty() && changed.len() <= 2,
+            "{} of {} segments changed",
+            changed.len(),
+            segments.len()
+        );
