+/// One verified segment of a segmented native batch: its file must have the
+/// listed size, SHA-256 and message count. The error says whether the file
+/// was missing, so the caller can retry against a newer manifest.
+fn load_ais_segment(
+    segment_dir: &std::path::Path,
+    segment: &AisSegmentRef,
+    keys: &mut HashSet<(PathBuf, String)>,
+) -> Result<Arc<Vec<UnifiedMessage>>, (bool, String)> {
+    use sha2::{Digest, Sha256};
+    if !ais_is_sha256_hex(&segment.sha256) {
+        return Err((false, "native segment name invalid".into()));
+    }
+    let path = segment_dir.join(format!("{}.json", segment.sha256));
+    let key = (path.clone(), segment.sha256.clone());
+    keys.insert(key.clone());
+    let cache =
+        AIS_SHARED_SEGMENT_CACHE.get_or_init(|| Mutex::new(std::collections::HashMap::new()));
+    if let Some(messages) = cache.lock().unwrap().get(&key).cloned() {
+        return Ok(messages);
+    }
+    let bytes = std::fs::read(&path).map_err(|e| {
+        (
+            e.kind() == std::io::ErrorKind::NotFound,
+            format!("native segment read: {e}"),
+        )
+    })?;
+    if bytes.len() as u64 != segment.bytes || ais_hex(&Sha256::digest(&bytes)) != segment.sha256 {
+        return Err((false, "native segment checksum mismatch".into()));
+    }
+    let messages: Vec<UnifiedMessage> =
+        serde_json::from_slice(&bytes).map_err(|e| (false, format!("native segment JSON: {e}")))?;
+    if messages.len() as u64 != segment.messages {
+        return Err((false, "native segment message count mismatch".into()));
+    }
+    let messages = Arc::new(messages);
+    cache.lock().unwrap().insert(key, messages.clone());
+    Ok(messages)
+}
