+pub fn parse_ais_shared_snapshot(
+    path: &str,
+    options: &LocalParseOptions,
+) -> Result<Vec<UnifiedMessage>, String> {
+    parse_ais_shared_snapshot_inner(path, options, true)
+}
+
+fn parse_ais_shared_snapshot_inner(
+    path: &str,
+    options: &LocalParseOptions,
+    retry_changed_manifest: bool,
+) -> Result<Vec<UnifiedMessage>, String> {
+    use sha2::{Digest, Sha256};
+    let manifest_path = std::path::Path::new(path);
+    let cache_root = manifest_path
+        .parent()
+        .and_then(std::path::Path::parent)
+        .ok_or("AIS snapshot path must be under usage/")?;
+    let manifest_bytes =
+        std::fs::read(manifest_path).map_err(|e| format!("AIS snapshot read: {e}"))?;
+    let manifest: serde_json::Value =
+        serde_json::from_slice(&manifest_bytes).map_err(|e| format!("AIS snapshot JSON: {e}"))?;
+    if manifest.get("schemaVersion").and_then(|v| v.as_u64()) != Some(1) {
+        return Err("unsupported AIS snapshot schema".into());
+    }
+    let partitions = manifest
+        .get("partitions")
+        .and_then(|v| v.as_object())
+        .ok_or("AIS snapshot partitions missing")?;
+    if manifest
+        .get("aggregateResults")
+        .and_then(serde_json::Value::as_array)
+        .is_none()
+    {
+        return Err("AIS snapshot aggregateResults missing or invalid".into());
+    }
+    let aggregate_generated_at = manifest
+        .get("aggregateGeneratedAt")
+        .and_then(serde_json::Value::as_str)
+        .ok_or("AIS snapshot aggregateGeneratedAt missing or invalid")?;
+    if chrono::DateTime::parse_from_rfc3339(aggregate_generated_at).is_err() {
+        return Err("AIS snapshot aggregateGeneratedAt invalid".into());
+    }
+    let mut unsupported_tools = std::collections::BTreeMap::<String, usize>::new();
+    for partition in partitions.values() {
+        if partition
+            .get("nativeBatch")
+            .is_none_or(serde_json::Value::is_null)
+        {
+            let tool = partition
+                .get("tool")
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or("unknown");
+            *unsupported_tools.entry(tool.to_string()).or_default() += 1;
+        }
+    }
+    let mut combined = Vec::new();
+    let mut unavailable_tools = unsupported_tools;
+    let mut manifest_cache_keys = HashSet::new();
+    let mut saw_missing_batch = false;
+    for (_partition_key, partition) in partitions {
+        let Some(batch) = partition.get("nativeBatch").filter(|v| !v.is_null()) else {
+            continue;
+        };
+        let tool = partition
+            .get("tool")
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or("unknown")
+            .to_string();
+        let rel = batch
+            .get("path")
+            .and_then(|v| v.as_str())
+            .ok_or("native batch path missing")?;
+        let rel_path = std::path::Path::new(rel);
+        if rel_path.is_absolute()
+            || rel_path.components().any(|c| {
+                matches!(
+                    c,
+                    std::path::Component::ParentDir
+                        | std::path::Component::RootDir
+                        | std::path::Component::Prefix(_)
+                )
+            })
+        {
+            *unavailable_tools.entry(tool).or_default() += 1;
+            continue;
+        }
+        let expected_partition_id = batch
+            .get("partitionId")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("native batch partition id missing")?;
+        if expected_partition_id.len() != 64
+            || !expected_partition_id
+                .bytes()
+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+        {
+            *unavailable_tools.entry(tool).or_default() += 1;
+            continue;
+        }
+        let expected_digest = batch
+            .get("sha256")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("native batch checksum missing")?;
+        let expected_generated_at = batch
+            .get("generatedAt")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("native batch generatedAt missing")?;
+        let batch_path = cache_root.join(rel_path);
+        let cache_key = (
+            batch_path.clone(),
+            expected_partition_id.to_string(),
+            expected_digest.to_string(),
+            expected_generated_at.to_string(),
+        );
+        manifest_cache_keys.insert(cache_key.clone());
+        if let Some(messages) = AIS_SHARED_NATIVE_BATCH_CACHE
+            .get_or_init(|| Mutex::new(std::collections::HashMap::new()))
+            .lock()
+            .unwrap()
+            .get(&cache_key)
+            .cloned()
+        {
+            combined.extend(messages);
+            continue;
+        }
+        let loaded = (|| -> Result<AisBatchEnvelope, String> {
+            let bytes = std::fs::read(&batch_path).map_err(|e| {
+                if e.kind() == std::io::ErrorKind::NotFound {
+                    saw_missing_batch = true;
+                }
+                format!("native batch read: {e}")
+            })?;
+            let digest = format!("{:x}", Sha256::digest(&bytes));
+            if expected_digest != digest {
+                return Err("native batch checksum mismatch".into());
+            }
+            let envelope: AisBatchEnvelope =
+                serde_json::from_slice(&bytes).map_err(|e| format!("native batch JSON: {e}"))?;
+            if expected_partition_id.len() != 64
+                || !expected_partition_id
+                    .bytes()
+                    .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+            {
+                return Err("native batch partition id invalid".into());
+            }
+            if envelope.schema_version != 1
+                || !envelope.complete
+                || envelope.partition_id != expected_partition_id
+            {
+                return Err("native batch envelope mismatch".into());
+            }
+            if chrono::DateTime::parse_from_rfc3339(&envelope.generated_at).is_err() {
+                return Err("native batch timestamp invalid".into());
+            }
+            if expected_generated_at != envelope.generated_at {
+                return Err("native batch generation mismatch".into());
+            }
+            Ok(envelope)
+        })();
+        match loaded {
+            Ok(envelope) => {
+                AIS_SHARED_NATIVE_BATCH_CACHE
+                    .get_or_init(|| Mutex::new(std::collections::HashMap::new()))
+                    .lock()
+                    .unwrap()
+                    .insert(cache_key, envelope.messages.clone());
+                combined.extend(envelope.messages)
+            }
+            Err(_) => *unavailable_tools.entry(tool).or_default() += 1,
+        }
+    }
+    if retry_changed_manifest && saw_missing_batch {
+        if let Ok(latest_bytes) = std::fs::read(manifest_path) {
+            if latest_bytes != manifest_bytes {
+                return parse_ais_shared_snapshot_inner(path, options, false);
+            }
+        }
+    }
+    AIS_SHARED_NATIVE_BATCH_CACHE
+        .get_or_init(|| Mutex::new(std::collections::HashMap::new()))
+        .lock()
+        .unwrap()
+        .retain(|key, _| manifest_cache_keys.contains(key));
+    let aggregate_generated_at = manifest
+        .get("aggregateGeneratedAt")
+        .and_then(serde_json::Value::as_str)
+        .unwrap_or("unknown generation");
+    let coverage_status = Some(format!(
+        "AIS snapshot aggregate {aggregate_generated_at}: all-time models/totals use report rows; daily, session, and project detail uses available native batches only; date-filtered cost is native-only.{}",
+        if unavailable_tools.is_empty() { String::new() } else {
+            format!(" Native detail unavailable: {}", unavailable_tools.iter().map(|(tool,count)| format!("{tool}: {count}")).collect::<Vec<_>>().join(", "))
+        }
+    ));
+    *AIS_SHARED_COVERAGE_STATUS
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .unwrap() = coverage_status;
+    *AIS_SHARED_PARSED_MANIFEST
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .unwrap() = Some((manifest_path.to_path_buf(), manifest));
+    let mut seen = HashSet::new();
+    combined.retain(|message| should_keep_deduped_message(&mut seen, message));
+    if let Some(clients) = options.clients.as_ref() {
+        let requested: HashSet<&str> = clients.iter().map(String::as_str).collect();
+        combined.retain(|message| {
+            retain_for_requested_clients(
+                &message.client,
+                &message.model_id,
+                &message.provider_id,
+                &requested,
+            )
+        });
+    }
+    Ok(filter_unified_messages(combined, options))
+}
+
+/// Coverage note from the most recent shared-snapshot load, for the TUI's
+/// persistent status line. `None` means every manifest partition has a native
+/// batch. It describes omission without inventing native messages.
+pub fn ais_shared_snapshot_coverage_status() -> Option<String> {
+    AIS_SHARED_COVERAGE_STATUS
+        .get_or_init(|| Mutex::new(None))
+        .lock()
+        .unwrap()
+        .clone()
+}
