+#[derive(serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct AisBatchEnvelope {
+    schema_version: u32,
+    partition_id: String,
+    generated_at: String,
+    complete: bool,
+    messages: Vec<UnifiedMessage>,
+}
+
+fn write_ais_export_if_requested(messages: &[UnifiedMessage]) -> Result<(), String> {
+    let path = std::env::var_os("TOKSCALE_AIS_EXPORT_PATH");
+    let partition_id = std::env::var("TOKSCALE_AIS_PARTITION_ID").ok();
+    let (path, partition_id) = match (path, partition_id) {
+        (None, None) => return Ok(()),
+        (Some(path), Some(partition_id)) => (path, partition_id),
+        _ => return Err("AIS export path and partition id must be set together".into()),
+    };
+    if partition_id.is_empty() {
+        return Err("AIS partition id is empty".into());
+    }
+    let path = std::path::PathBuf::from(path);
+    let parent = path.parent().ok_or("AIS export path has no parent")?;
+    std::fs::create_dir_all(parent).map_err(|e| format!("AIS export directory: {e}"))?;
+    let generated_at = chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true);
+    let envelope = AisBatchEnvelope {
+        schema_version: 1,
+        partition_id,
+        generated_at,
+        complete: true,
+        messages: messages.to_vec(),
+    };
+    let bytes = serde_json::to_vec(&envelope).map_err(|e| format!("AIS batch encode: {e}"))?;
+    let temp = parent.join(format!(
+        ".ais-batch-{}-{}.tmp",
+        std::process::id(),
+        chrono::Utc::now().timestamp_nanos_opt().unwrap_or_default()
+    ));
+    use std::io::Write;
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&temp)
+        .map_err(|e| format!("AIS batch temp: {e}"))?;
+    if let Err(error) = file.write_all(&bytes).and_then(|_| file.sync_all()) {
+        drop(file);
+        let _ = std::fs::remove_file(&temp);
+        return Err(format!("AIS batch write: {error}"));
+    }
+    drop(file);
+    std::fs::rename(&temp, &path).map_err(|e| {
+        let _ = std::fs::remove_file(&temp);
+        format!("AIS batch publish: {e}")
+    })?;
+    Ok(())
+}
+
+/// Load only complete immutable batches named by AIS's authoritative manifest.
+/// Relative batch paths are rooted at the cache directory above `usage/`.
+/// Canonical AIS all-time aggregate derived from report rows, separate from
+/// native messages so no synthetic dates, sessions, or costs are invented.
+pub fn ais_shared_snapshot_report(
+    path: &str,
+    clients: Option<&[String]>,
+) -> Result<serde_json::Value, String> {
+    ais_shared_snapshot_report_impl(path, clients, false)
+}
+
+/// TUI overlay variant: reuse the exact manifest already parsed with native
+/// batches, keeping aggregate and detail on one generation without rereading
+/// the snapshot or its potentially large immutable batch files.
+pub fn ais_shared_snapshot_report_from_loaded(
+    path: &str,
+    clients: Option<&[String]>,
+) -> Result<serde_json::Value, String> {
+    ais_shared_snapshot_report_impl(path, clients, true)
+}
+
+fn ais_shared_snapshot_report_impl(
+    path: &str,
+    clients: Option<&[String]>,
+    use_loaded_manifest: bool,
+) -> Result<serde_json::Value, String> {
+    let manifest_path = PathBuf::from(path);
+    let cached = if use_loaded_manifest {
+        AIS_SHARED_PARSED_MANIFEST
+            .get_or_init(|| Mutex::new(None))
+            .lock()
+            .unwrap()
+            .as_ref()
+            .filter(|(cached_path, _)| cached_path == &manifest_path)
+            .map(|(_, manifest)| manifest.clone())
+    } else {
+        None
+    };
+    let manifest: serde_json::Value = match cached {
+        Some(manifest) => manifest,
+        None => serde_json::from_slice(
+            &std::fs::read(path).map_err(|e| format!("AIS snapshot read: {e}"))?,
+        )
+        .map_err(|e| format!("AIS snapshot JSON: {e}"))?,
+    };
+    if manifest.get("schemaVersion").and_then(|v| v.as_u64()) != Some(1) {
+        return Err("unsupported AIS snapshot schema".into());
+    }
+    let partitions = manifest
+        .get("partitions")
+        .and_then(|v| v.as_object())
+        .ok_or("AIS snapshot partitions missing")?;
+    let mut totals = (0i64, 0i64, 0i64, 0i64, 0i64, 0.0f64);
+    let mut entries = std::collections::BTreeMap::<
+        (String, String, String),
+        (i64, i64, i64, i64, i64, i64, f64),
+    >::new();
+    let results = manifest
+        .get("aggregateResults")
+        .and_then(|v| v.as_array())
+        .ok_or("AIS snapshot aggregateResults missing or invalid")?;
+    let aggregate_generated_at = manifest
+        .get("aggregateGeneratedAt")
+        .and_then(|v| v.as_str())
+        .ok_or("AIS snapshot aggregateGeneratedAt missing or invalid")?;
+    if chrono::DateTime::parse_from_rfc3339(aggregate_generated_at).is_err() {
+        return Err("AIS snapshot aggregateGeneratedAt invalid".into());
+    }
+    for result in results {
+        let Some(report) = result.get("report") else {
+            continue;
+        };
+        let Some(rows) = report.get("entries").and_then(|v| v.as_array()) else {
+            continue;
+        };
+        for row in rows {
+            let client = row
+                .get("client")
+                .and_then(|v| v.as_str())
+                .ok_or("AIS aggregate report client missing or invalid")?
+                .to_string();
+            if clients.is_some_and(|filter| !filter.iter().any(|requested| requested == &client)) {
+                continue;
+            }
+            let model = row
+                .get("model")
+                .and_then(|v| v.as_str())
+                .unwrap_or("unknown")
+                .to_string();
+            let provider = row
+                .get("provider")
+                .and_then(|v| v.as_str())
+                .or_else(|| result.get("provider").and_then(|v| v.as_str()))
+                .unwrap_or("unknown")
+                .to_string();
+            let n = |key: &str| row.get(key).and_then(|v| v.as_i64()).unwrap_or(0);
+            let cost = row.get("cost").and_then(|v| v.as_f64()).unwrap_or(0.0);
+            let e = entries.entry((client, model, provider)).or_default();
+            e.0 = e.0.saturating_add(n("input"));
+            e.1 = e.1.saturating_add(n("output"));
+            e.2 = e.2.saturating_add(n("cacheRead"));
+            e.3 = e.3.saturating_add(n("cacheWrite"));
+            e.4 = e.4.saturating_add(n("reasoning"));
+            e.5 = e.5.saturating_add(n("messageCount"));
+            e.6 += cost;
+        }
+    }
+    let entries: Vec<_> = entries.into_iter().map(|((client, model, provider), e)| {
+        totals.0 = totals.0.saturating_add(e.0); totals.1 = totals.1.saturating_add(e.1);
+        totals.2 = totals.2.saturating_add(e.2); totals.3 = totals.3.saturating_add(e.3);
+        totals.4 = totals.4.saturating_add(e.5); totals.5 += e.6;
+        serde_json::json!({"client":client,"model":model,"provider":provider,"input":e.0,"output":e.1,"cacheRead":e.2,"cacheWrite":e.3,"reasoning":e.4,"messageCount":e.5,"cost":e.6})
+    }).collect();
+    let native_coverage = manifest.get("nativeCoverage").cloned().unwrap_or_else(|| {
+        let mut counts = std::collections::BTreeMap::<String, usize>::new();
+        for partition in partitions.values() {
+            let state = if partition
+                .get("nativeBatch")
+                .is_some_and(|value| !value.is_null())
+            {
+                "supported"
+            } else {
+                "unsupported-or-pending"
+            };
+            *counts.entry(state.to_string()).or_default() += 1;
+        }
+        serde_json::to_value(counts).unwrap_or_else(|_| serde_json::json!({}))
+    });
+    let coverage = format!(
+        "Native details are available only from manifest-listed batches; JSON does not load native detail ({native_coverage})"
+    );
+    Ok(
+        serde_json::json!({"entries":entries,"totalInput":totals.0,"totalOutput":totals.1,"totalCacheRead":totals.2,"totalCacheWrite":totals.3,"totalMessages":totals.4,"totalCost":totals.5,"coverage":coverage,"aggregateGeneratedAt":aggregate_generated_at,"detailCoverage":"manifest-native-batches-listed; not-loaded-by-json","dateFilteredCostCoverage":"native-only; not-projected-in-all-time-json"}),
+    )
+}
