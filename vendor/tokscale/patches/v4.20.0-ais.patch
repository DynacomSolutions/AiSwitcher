+            return Ok(());
+        }
+        let selected: HashSet<&str> = clients.iter().map(String::as_str).collect();
+        let defaults = crate::tui::ais_default_snapshot_clients();
+        let default_selection: HashSet<&str> = defaults.iter().map(String::as_str).collect();
+        let client_filter = if selected == default_selection {
+            None
+        } else {
+            Some(clients)
+        };
+        self.apply_ais_report_overlay_from_path(data, client_filter, &snapshot)
