+    #[test]
+    #[serial]
+    fn ais_shared_snapshot_native_batch_cache_tracks_only_current_manifest_generation() {
+        use super::{
+            parse_ais_shared_snapshot, AisBatchEnvelope, AIS_SHARED_NATIVE_BATCH_CACHE,
+        };
+        use sha2::{Digest, Sha256};
+
+        let cache = AIS_SHARED_NATIVE_BATCH_CACHE
+            .get_or_init(|| std::sync::Mutex::new(std::collections::HashMap::new()));
+        cache.lock().unwrap().clear();
+
+        let (_temp, root) = crate::sessions::canonical_tempdir();
+        let usage = root.join("usage");
+        let batch_dir = usage.join("native");
+        std::fs::create_dir_all(&batch_dir).unwrap();
+        let manifest_path = usage.join("snapshot.json");
+        let partition_id = "c".repeat(64);
+
+        for generation_index in 0..6 {
+            let generation = format!("2026-10-23T08:00:{generation_index:02}.000Z");
+            let file_name = format!("generation-{generation_index}.json");
+            let batch_path = batch_dir.join(&file_name);
+            let message = make_workspace_message(
+                "codex", "gpt-5", "openai", "cache-test", 1.0 + generation_index as f64,
+                None, None,
+            );
+            let bytes = serde_json::to_vec(&AisBatchEnvelope {
+                schema_version: 1,
+                partition_id: partition_id.clone(),
+                generated_at: generation.clone(),
+                complete: true,
+                messages: vec![message],
+            })
+            .unwrap();
+            std::fs::write(&batch_path, &bytes).unwrap();
+            let digest = format!("{:x}", Sha256::digest(&bytes));
+            let manifest = serde_json::json!({
+                "schemaVersion": 1,
+                "aggregateGeneratedAt": generation,
+                "aggregateResults": [],
+                "partitions": {
+                    "cache-test": {
+                        "tool": "codex",
+                        "results": [],
+                        "nativeBatch": {
+                            "path": format!("usage/native/{file_name}"),
+                            "sha256": digest,
+                            "generatedAt": generation,
+                            "partitionId": partition_id
+                        }
+                    }
+                }
+            });
+            std::fs::write(&manifest_path, serde_json::to_vec(&manifest).unwrap()).unwrap();
+
+            let loaded = parse_ais_shared_snapshot(
+                &manifest_path.to_string_lossy(),
+                &LocalParseOptions::default(),
+            )
+            .unwrap();
+            assert_eq!(loaded.len(), 1);
+            assert_eq!(cache.lock().unwrap().len(), 1, "generation {generation_index}");
+
+            // The exact manifest key must be served from cache even if its
+            // immutable file is temporarily unavailable during a retry.
+            std::fs::remove_file(&batch_path).unwrap();
+            let reused = parse_ais_shared_snapshot(
+                &manifest_path.to_string_lossy(),
+                &LocalParseOptions::default(),
+            )
+            .unwrap();
+            assert_eq!(reused.len(), 1);
+            assert_eq!(cache.lock().unwrap().len(), 1);
+        }
+
+        // Invalid authoritative metadata fails closed and does not mutate the
+        // last successful generation's bounded cache.
+        std::fs::write(&manifest_path, br#"{"schemaVersion":1,"partitions":{}}"#).unwrap();
+        assert!(parse_ais_shared_snapshot(
+            &manifest_path.to_string_lossy(),
+            &LocalParseOptions::default(),
+        )
+        .is_err());
+        assert_eq!(cache.lock().unwrap().len(), 1);
+    }
