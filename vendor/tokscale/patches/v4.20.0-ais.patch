+
+    fn apply_ais_report_overlay_from_path(
+        &self,
+        data: &mut UsageData,
+        clients: Option<&[String]>,
+        snapshot: &str,
+    ) -> Result<()> {
+        let report = tokscale_core::ais_shared_snapshot_report_from_loaded(snapshot, clients)
+            .map_err(anyhow::Error::msg)?;
+        let entries = report
+            .get("entries")
+            .and_then(serde_json::Value::as_array)
+            .ok_or_else(|| anyhow::anyhow!("AIS shared aggregate entries missing"))?;
+        let mut models = Vec::with_capacity(entries.len());
+        let mut total_tokens = 0u64;
+        for entry in entries {
+            let client = entry
+                .get("client")
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or("unknown")
+                .to_string();
+            let model = entry
+                .get("model")
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or("unknown")
+                .to_string();
+            let provider = entry
+                .get("provider")
+                .and_then(serde_json::Value::as_str)
+                .unwrap_or("unknown")
+                .to_string();
+            let tokens = TokenBreakdown {
+                input: entry
+                    .get("input")
+                    .and_then(serde_json::Value::as_u64)
+                    .unwrap_or(0),
+                output: entry
+                    .get("output")
+                    .and_then(serde_json::Value::as_u64)
+                    .unwrap_or(0),
+                cache_read: entry
+                    .get("cacheRead")
+                    .and_then(serde_json::Value::as_u64)
+                    .unwrap_or(0),
+                cache_write: entry
+                    .get("cacheWrite")
+                    .and_then(serde_json::Value::as_u64)
+                    .unwrap_or(0),
+                reasoning: entry
+                    .get("reasoning")
+                    .and_then(serde_json::Value::as_u64)
+                    .unwrap_or(0),
+            };
+            total_tokens = total_tokens.saturating_add(tokens.total());
+            let group_model = model_name_for_grouping(&client, &provider, &model);
+            let color_key = normalize_model_for_grouping(&model);
+            models.push(ModelUsage {
+                model: group_model,
+                color_key,
+                provider: provider.clone(),
+                client: client.clone(),
+                workspace_key: None,
+                workspace_label: None,
+                tokens,
+                cost: entry
+                    .get("cost")
+                    .and_then(serde_json::Value::as_f64)
+                    .unwrap_or(0.0),
+                performance: ModelPerformance::default(),
+                session_count: 0,
+                group_key: format!("{client}:{provider}:{model}"),
+                daily: Vec::new(),
+            });
+        }
+        data.models = models;
+        data.total_tokens = total_tokens;
+        data.total_cost = report
+            .get("totalCost")
+            .and_then(serde_json::Value::as_f64)
+            .unwrap_or(0.0);
+        Ok(())
+    }
